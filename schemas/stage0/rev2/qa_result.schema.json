{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenart.local/schemas/stage0/rev2/qa_result.schema.json",
  "title": "ZenArt Stage 0 Rev2 QA Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "check_id",
    "check_category",
    "severity",
    "workflow",
    "asset_id",
    "evidence",
    "export_gate",
    "auto_fix_available",
    "review_required",
    "user_visible_message",
    "admin_reason",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "stage0.rev2"
    },
    "check_id": {
      "type": "string",
      "pattern": "^qa_[a-z0-9_]+$"
    },
    "check_category": {
      "enum": [
        "file_integrity",
        "dimensions",
        "aspect_ratio",
        "safe_area",
        "blank_output",
        "duplicate_similarity",
        "four_option_distinctness",
        "text_readability",
        "structured_text",
        "product_logo_preservation",
        "forbidden_claims",
        "watermark_signature_risk",
        "export_completeness"
      ]
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "blocking"
      ]
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed",
        "expected",
        "trace_id",
        "fixture_id",
        "source_artifacts"
      ],
      "properties": {
        "observed": {
          "$ref": "#/$defs/evidence_map"
        },
        "expected": {
          "$ref": "#/$defs/evidence_map"
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "fixture_id": {
          "type": "string",
          "pattern": "^fx_[a-z0-9_]+$"
        },
        "source_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "export_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks_final_export",
        "eligible_admin_override",
        "override_requires_audit"
      ],
      "properties": {
        "blocks_final_export": {
          "type": "boolean"
        },
        "eligible_admin_override": {
          "type": "boolean"
        },
        "override_requires_audit": {
          "type": "boolean"
        }
      }
    },
    "auto_fix_available": {
      "type": "boolean"
    },
    "review_required": {
      "type": "boolean"
    },
    "user_visible_message": {
      "type": "string"
    },
    "admin_reason": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "evidence_map": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "array",
          "object"
        ]
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blueprint_sections",
        "created_by_lane"
      ],
      "properties": {
        "blueprint_sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^((6|8|15)\\.)"
          }
        },
        "created_by_lane": {
          "enum": [
            "lane2",
            "lane6"
          ]
        }
      }
    }
  }
}
