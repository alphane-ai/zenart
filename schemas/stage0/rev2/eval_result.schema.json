{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenart.local/schemas/stage0/rev2/eval_result.schema.json",
  "title": "ZenArt Stage 0 Rev2 Eval Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "suite_id",
    "subject",
    "status",
    "completed_at",
    "created_at",
    "summary",
    "fixture_results",
    "runner_contract",
    "storage_contract",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "stage0.rev2"
    },
    "result_id": {
      "type": "string",
      "pattern": "^eval_result_[a-z0-9_]+$"
    },
    "suite_id": {
      "type": "string",
      "pattern": "^eval_[a-z0-9_]+$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_type",
        "subject_id",
        "version",
        "candidate_status_after_eval"
      ],
      "properties": {
        "subject_type": {
          "enum": [
            "skill_version",
            "prompt_fragment",
            "prompt_mutation",
            "meta_prompt",
            "image_spec",
            "vertical_workflow_pack"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "candidate_status_after_eval": {
          "enum": [
            "draft",
            "eligible_for_canary",
            "eligible_for_active",
            "blocked"
          ]
        }
      }
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "blocked"
      ]
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_fixtures",
        "passed_fixtures",
        "failed_fixtures",
        "blocked_fixtures",
        "golden_passed",
        "critical_safety_regressions",
        "regression_pass_rate",
        "trace_complete",
        "export_contract_complete",
        "qa_fixture_coverage_complete",
        "qa_categories_covered",
        "safety_enforcement_points_covered"
      ],
      "properties": {
        "total_fixtures": {
          "type": "integer",
          "minimum": 1
        },
        "passed_fixtures": {
          "type": "integer",
          "minimum": 0
        },
        "failed_fixtures": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_fixtures": {
          "type": "integer",
          "minimum": 0
        },
        "golden_passed": {
          "type": "boolean"
        },
        "critical_safety_regressions": {
          "type": "integer",
          "minimum": 0
        },
        "regression_pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "trace_complete": {
          "type": "boolean"
        },
        "export_contract_complete": {
          "type": "boolean"
        },
        "qa_fixture_coverage_complete": {
          "type": "boolean"
        },
        "qa_categories_covered": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "file_integrity",
              "dimensions",
              "aspect_ratio",
              "safe_area",
              "blank_output",
              "duplicate_similarity",
              "four_option_distinctness",
              "text_readability",
              "structured_text",
              "product_logo_preservation",
              "forbidden_claims",
              "watermark_signature_risk",
              "export_completeness"
            ]
          }
        },
        "safety_enforcement_points_covered": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "brief",
              "provider_request",
              "provider_response",
              "qa",
              "export"
            ]
          }
        }
      }
    },
    "fixture_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "category",
          "workflow",
          "status",
          "candidate_count",
          "expected_safety_action",
          "observed_safety_action",
          "safety_decision_contract",
          "qa_check_ids",
          "qa_coverage_contract",
          "trace_contract",
          "export_contract",
          "qa_export_gate",
          "failure_reasons"
        ],
        "properties": {
          "fixture_id": {
            "type": "string",
            "pattern": "^fx_[a-z0-9_]+$"
          },
          "category": {
            "enum": [
              "golden",
              "ambiguous_brief",
              "unsafe",
              "negative",
              "brand_product_preservation",
              "text_heavy",
              "export_completeness",
              "regression",
              "red_team"
            ]
          },
          "workflow": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "blocked"
            ]
          },
          "candidate_count": {
            "type": "integer",
            "minimum": 0
          },
          "expected_safety_action": {
            "enum": [
              "allow",
              "warn",
              "require_user_confirmation",
              "require_admin_review",
              "block"
            ]
          },
          "observed_safety_action": {
            "enum": [
              "allow",
              "warn",
              "require_user_confirmation",
              "require_admin_review",
              "block"
            ]
          },
          "safety_decision_contract": {
            "$ref": "#/$defs/safety_decision_contract"
          },
          "qa_check_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^qa_[a-z0-9_]+$"
            }
          },
          "qa_coverage_contract": {
            "$ref": "#/$defs/qa_coverage_contract"
          },
          "trace_contract": {
            "$ref": "#/$defs/trace_contract"
          },
          "export_contract": {
            "$ref": "#/$defs/export_contract"
          },
          "qa_export_gate": {
            "$ref": "#/$defs/qa_export_gate"
          },
          "failure_reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "storage_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table",
        "required_columns",
        "required_indexes",
        "required_query_filters",
        "summary_json_contains_fixture_results",
        "summary_projection_fields",
        "fixture_result_projection_fields",
        "admin_read_projection_required",
        "read_without_eval_rerun",
        "tenant_scoped",
        "subject_scoped",
        "latest_result_resolvable",
        "immutable_rows",
        "idempotent_replay_key",
        "idempotent_replay_conflict_policy",
        "retention_contract",
        "no_public_delete_operation"
      ],
      "properties": {
        "table": {
          "const": "eval_results"
        },
        "required_columns": {
          "type": "array",
          "minItems": 11,
          "uniqueItems": true,
          "items": {
            "enum": [
              "id",
              "tenant_id",
              "eval_suite_id",
              "subject_type",
              "subject_id",
              "subject_version",
              "status",
              "summary",
              "runner",
              "runner_sha256",
              "completed_at",
              "created_at"
            ]
          }
        },
        "required_indexes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "idx_eval_results_tenant_suite_subject_created_at",
              "idx_eval_results_subject_status_completed_at"
            ]
          }
        },
        "required_query_filters": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "tenant_id",
              "eval_suite_id",
              "subject_type",
              "subject_id",
              "subject_version",
              "status",
              "completed_after",
              "latest_only"
            ]
          }
        },
        "summary_json_contains_fixture_results": {
          "type": "boolean",
          "const": true
        },
        "summary_projection_fields": {
          "$ref": "#/$defs/summary_projection_fields"
        },
        "fixture_result_projection_fields": {
          "$ref": "#/$defs/fixture_result_projection_fields"
        },
        "admin_read_projection_required": {
          "type": "boolean",
          "const": true
        },
        "read_without_eval_rerun": {
          "type": "boolean",
          "const": true
        },
        "tenant_scoped": {
          "type": "boolean",
          "const": true
        },
        "subject_scoped": {
          "type": "boolean",
          "const": true
        },
        "latest_result_resolvable": {
          "type": "boolean",
          "const": true
        },
        "immutable_rows": {
          "type": "boolean",
          "const": true
        },
        "idempotent_replay_key": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "tenant_id",
              "eval_suite_id",
              "subject_type",
              "subject_id",
              "subject_version",
              "runner_sha256"
            ]
          }
        },
        "idempotent_replay_conflict_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exact_replay_returns_existing_row",
            "same_key_different_result_rejected",
            "same_subject_other_tenant_inserts_new_row",
            "conflict_requires_admin_audit",
            "blocked_conflict_denies_activation"
          ],
          "properties": {
            "exact_replay_returns_existing_row": {
              "const": true
            },
            "same_key_different_result_rejected": {
              "const": true
            },
            "same_subject_other_tenant_inserts_new_row": {
              "const": true
            },
            "conflict_requires_admin_audit": {
              "const": true
            },
            "blocked_conflict_denies_activation": {
              "const": true
            }
          }
        },
        "retention_contract": {
          "$ref": "#/$defs/retention_contract"
        },
        "no_public_delete_operation": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "runner_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "runner_sha256",
        "deterministic_replay_command",
        "writes_stored_fixture",
        "check_mode_compares_exact_json",
        "source_fixture_digests"
      ],
      "properties": {
        "runner": {
          "const": "scripts/run_stage0_eval.py"
        },
        "runner_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "deterministic_replay_command": {
          "const": "python3 scripts/run_stage0_eval.py --check"
        },
        "writes_stored_fixture": {
          "const": true
        },
        "check_mode_compares_exact_json": {
          "const": true
        },
        "source_fixture_digests": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(fixtures/stage0/rev2/eval/(starter_eval_suite|qa_results|safety_rules)\\.json|fixtures/stage0/rev2/workflows/[a-z0-9_]+\\.json)$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blueprint_sections",
        "created_by_lane",
        "runner"
      ],
      "properties": {
        "blueprint_sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^((12|14|15|23|25)(\\.|$)|24$)"
          }
        },
        "created_by_lane": {
          "const": "lane2"
        },
        "runner": {
          "const": "scripts/run_stage0_eval.py"
        }
      }
    }
  },
  "$defs": {
    "qa_category_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "file_integrity",
          "dimensions",
          "aspect_ratio",
          "safe_area",
          "blank_output",
          "duplicate_similarity",
          "four_option_distinctness",
          "text_readability",
          "structured_text",
          "product_logo_preservation",
          "forbidden_claims",
          "watermark_signature_risk",
          "export_completeness"
        ]
      }
    },
    "summary_projection_fields": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {
        "enum": [
          "total_fixtures",
          "passed_fixtures",
          "failed_fixtures",
          "blocked_fixtures",
          "golden_passed",
          "critical_safety_regressions",
          "regression_pass_rate",
          "trace_complete",
          "export_contract_complete",
          "qa_fixture_coverage_complete",
          "qa_categories_covered",
          "safety_enforcement_points_covered"
        ]
      }
    },
    "fixture_result_projection_fields": {
      "type": "array",
      "minItems": 13,
      "uniqueItems": true,
      "items": {
        "enum": [
          "fixture_id",
          "category",
          "workflow",
          "status",
          "expected_safety_action",
          "observed_safety_action",
          "safety_decision_contract",
          "qa_check_ids",
          "qa_coverage_contract",
          "trace_contract",
          "export_contract",
          "qa_export_gate",
          "failure_reasons"
        ]
      }
    },
    "safety_decision_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "decision_source",
        "source_rule_ids",
        "enforcement_points",
        "trace_status_required",
        "persisted_decision_required",
        "audit_required",
        "export_gate_effect"
      ],
      "properties": {
        "decision": {
          "enum": [
            "allow",
            "warn",
            "require_user_confirmation",
            "require_admin_review",
            "block"
          ]
        },
        "decision_source": {
          "enum": [
            "default_no_match",
            "linked_safety_rule"
          ]
        },
        "source_rule_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^safety_[a-z0-9_]+$"
          }
        },
        "enforcement_points": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "brief",
              "provider_request",
              "provider_response",
              "qa",
              "export"
            ]
          }
        },
        "trace_status_required": {
          "const": true
        },
        "persisted_decision_required": {
          "const": true
        },
        "audit_required": {
          "type": "boolean"
        },
        "export_gate_effect": {
          "enum": [
            "allow_when_export_contract_complete",
            "allow_with_warning",
            "hold_until_user_confirmation",
            "hold_until_admin_review",
            "block_final_export"
          ]
        }
      }
    },
    "retention_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retain_pass_fail_blocked_results",
        "retain_summary_json",
        "retain_runner_hash",
        "deletion_requires_admin_audit",
        "redaction_requires_admin_audit",
        "no_public_delete_operation",
        "minimum_retention_days"
      ],
      "properties": {
        "retain_pass_fail_blocked_results": {
          "const": true
        },
        "retain_summary_json": {
          "const": true
        },
        "retain_runner_hash": {
          "const": true
        },
        "deletion_requires_admin_audit": {
          "const": true
        },
        "redaction_requires_admin_audit": {
          "const": true
        },
        "no_public_delete_operation": {
          "const": true
        },
        "minimum_retention_days": {
          "type": "integer",
          "minimum": 365
        }
      }
    },
    "qa_coverage_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_qa_categories",
        "observed_qa_categories",
        "missing_qa_categories",
        "workflow_required_qa_categories",
        "coverage_complete"
      ],
      "properties": {
        "expected_qa_categories": {
          "$ref": "#/$defs/qa_category_list"
        },
        "observed_qa_categories": {
          "$ref": "#/$defs/qa_category_list"
        },
        "missing_qa_categories": {
          "$ref": "#/$defs/qa_category_list"
        },
        "workflow_required_qa_categories": {
          "$ref": "#/$defs/qa_category_list"
        },
        "coverage_complete": {
          "type": "boolean"
        }
      }
    },
    "trace_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "has_schema_validation",
        "has_provenance",
        "has_safety_status",
        "has_qa_eval_status",
        "has_quota_transaction",
        "has_admin_visibility",
        "has_user_failure_mapping"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "pattern": "^trace_[a-z0-9_]+$"
        },
        "has_schema_validation": {
          "type": "boolean",
          "const": true
        },
        "has_provenance": {
          "type": "boolean",
          "const": true
        },
        "has_safety_status": {
          "type": "boolean",
          "const": true
        },
        "has_qa_eval_status": {
          "type": "boolean",
          "const": true
        },
        "has_quota_transaction": {
          "type": "boolean",
          "const": true
        },
        "has_admin_visibility": {
          "type": "boolean",
          "const": true
        },
        "has_user_failure_mapping": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "export_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "qa_report",
        "metadata",
        "trace_provenance",
        "safety_disclaimer_when_applicable",
        "blocks_when_incomplete"
      ],
      "properties": {
        "manifest": {
          "type": "boolean"
        },
        "qa_report": {
          "type": "boolean"
        },
        "metadata": {
          "type": "boolean"
        },
        "trace_provenance": {
          "type": "boolean"
        },
        "safety_disclaimer_when_applicable": {
          "type": "boolean"
        },
        "blocks_when_incomplete": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "qa_export_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_export_allowed",
        "blocking_qa_check_ids",
        "blocking_qa_categories",
        "safety_blocks_export",
        "export_artifacts_complete",
        "admin_override_required_for_export",
        "override_requires_audit"
      ],
      "properties": {
        "final_export_allowed": {
          "type": "boolean"
        },
        "blocking_qa_check_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^qa_[a-z0-9_]+$"
          }
        },
        "blocking_qa_categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "file_integrity",
              "dimensions",
              "aspect_ratio",
              "safe_area",
              "blank_output",
              "duplicate_similarity",
              "four_option_distinctness",
              "text_readability",
              "structured_text",
              "product_logo_preservation",
              "forbidden_claims",
              "watermark_signature_risk",
              "export_completeness"
            ]
          }
        },
        "safety_blocks_export": {
          "type": "boolean"
        },
        "export_artifacts_complete": {
          "type": "boolean"
        },
        "admin_override_required_for_export": {
          "type": "boolean"
        },
        "override_requires_audit": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
