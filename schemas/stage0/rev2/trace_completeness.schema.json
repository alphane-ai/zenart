{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenart.local/schemas/stage0/rev2/trace_completeness.schema.json",
  "title": "ZenArt Stage 0 Rev2 Trace Completeness Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "blueprint_source",
    "required_trace_fields",
    "required_pipeline_steps",
    "traces",
    "negative_trace_cases",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "stage0.rev2"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^trace_contract_[a-z0-9_]+$"
    },
    "blueprint_source": {
      "const": "Docs/stage0_blueprint_rev2.md"
    },
    "required_trace_fields": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "schema_validation",
          "provenance",
          "safety_status",
          "qa_eval_status",
          "quota_transaction_id",
          "admin_visibility",
          "user_failure_mapping"
        ]
      }
    },
    "required_pipeline_steps": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "brief",
          "provider_request",
          "provider_response",
          "qa",
          "export"
        ]
      }
    },
    "traces": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trace_id",
          "fixture_id",
          "workflow",
          "task_id",
          "request_id",
          "covered_steps",
          "step_events",
          "schema_validation",
          "provenance",
          "safety_status",
          "qa_eval_status",
          "quota_transaction_id",
          "admin_visibility",
          "user_failure_mapping",
          "export_references",
          "artifact_links",
          "eval_result_ref",
          "qa_result_refs"
        ],
        "properties": {
          "trace_id": {
            "type": "string",
            "pattern": "^trace_[a-z0-9_]+$"
          },
          "fixture_id": {
            "type": "string",
            "pattern": "^fx_[a-z0-9_]+$"
          },
          "workflow": {
            "type": "string",
            "minLength": 1
          },
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "covered_steps": {
            "type": "array",
            "minItems": 5,
            "uniqueItems": true,
            "items": {
              "enum": [
                "brief",
                "provider_request",
                "provider_response",
                "qa",
                "export"
              ]
            }
          },
          "step_events": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "$ref": "#/$defs/trace_step_event"
            }
          },
          "schema_validation": {
            "$ref": "#/$defs/trace_boolean_evidence"
          },
          "provenance": {
            "$ref": "#/$defs/trace_boolean_evidence"
          },
          "safety_status": {
            "$ref": "#/$defs/trace_boolean_evidence"
          },
          "qa_eval_status": {
            "$ref": "#/$defs/trace_boolean_evidence"
          },
          "quota_transaction_id": {
            "type": "string",
            "minLength": 1
          },
          "admin_visibility": {
            "$ref": "#/$defs/trace_boolean_evidence"
          },
          "user_failure_mapping": {
            "$ref": "#/$defs/trace_boolean_evidence"
          },
          "export_references": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "manifest",
              "qa_report",
              "metadata",
              "trace_provenance",
              "safety_disclaimer_when_applicable"
            ],
            "properties": {
              "manifest": {
                "type": "boolean"
              },
              "qa_report": {
                "type": "boolean"
              },
              "metadata": {
                "type": "boolean"
              },
              "trace_provenance": {
                "type": "boolean"
              },
              "safety_disclaimer_when_applicable": {
                "type": "boolean"
              }
            }
          },
          "artifact_links": {
            "$ref": "#/$defs/artifact_links"
          },
          "eval_result_ref": {
            "$ref": "#/$defs/eval_result_ref"
          },
          "qa_result_refs": {
            "$ref": "#/$defs/qa_result_refs"
          }
        }
      }
    },
    "negative_trace_cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/negative_trace_case"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blueprint_sections",
        "created_by_lane"
      ],
      "properties": {
        "blueprint_sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^((8|12|15|25)\\.|24$)"
          }
        },
        "created_by_lane": {
          "const": "lane2"
        }
      }
    }
  },
  "$defs": {
    "trace_boolean_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "source"
      ],
      "properties": {
        "present": {
          "const": true
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trace_step_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_name",
        "emission_order",
        "trace_id",
        "task_id",
        "request_id",
        "storage_table",
        "schema_validation",
        "provenance",
        "safety_status",
        "safety_decision_ref",
        "qa_eval_status",
        "quota_transaction_id",
        "admin_visibility",
        "user_failure_mapping"
      ],
      "properties": {
        "step_name": {
          "enum": [
            "brief",
            "provider_request",
            "provider_response",
            "qa",
            "export"
          ]
        },
        "emission_order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "trace_id": {
          "type": "string",
          "pattern": "^trace_[a-z0-9_]+$"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "storage_table": {
          "const": "agent_traces"
        },
        "schema_validation": {
          "$ref": "#/$defs/trace_boolean_evidence"
        },
        "provenance": {
          "$ref": "#/$defs/trace_boolean_evidence"
        },
        "safety_status": {
          "$ref": "#/$defs/trace_boolean_evidence"
        },
        "safety_decision_ref": {
          "$ref": "#/$defs/safety_decision_ref"
        },
        "qa_eval_status": {
          "$ref": "#/$defs/trace_boolean_evidence"
        },
        "quota_transaction_id": {
          "type": "string",
          "minLength": 1
        },
        "admin_visibility": {
          "$ref": "#/$defs/trace_boolean_evidence"
        },
        "user_failure_mapping": {
          "$ref": "#/$defs/trace_boolean_evidence"
        },
        "eval_result_ref": {
          "$ref": "#/$defs/trace_step_eval_result_ref"
        },
        "qa_result_refs": {
          "$ref": "#/$defs/trace_step_qa_result_refs"
        }
      }
    },
    "eval_result_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "table",
        "fixture_id",
        "status",
        "qa_export_gate_final_export_allowed"
      ],
      "properties": {
        "result_id": {
          "const": "eval_result_stage0_rev2_starter_contract"
        },
        "table": {
          "const": "eval_results"
        },
        "fixture_id": {
          "type": "string",
          "pattern": "^fx_[a-z0-9_]+$"
        },
        "status": {
          "enum": [
            "pass",
            "blocked",
            "fail"
          ]
        },
        "qa_export_gate_final_export_allowed": {
          "type": "boolean"
        }
      }
    },
    "qa_result_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table",
        "check_ids",
        "blocking_check_ids",
        "coverage_complete"
      ],
      "properties": {
        "table": {
          "const": "qa_results"
        },
        "check_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^qa_[a-z0-9_]+$"
          }
        },
        "blocking_check_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^qa_[a-z0-9_]+$"
          }
        },
        "coverage_complete": {
          "type": "boolean"
        }
      }
    },
    "trace_step_eval_result_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "table",
        "fixture_id",
        "final_export_allowed",
        "blocking_qa_check_ids"
      ],
      "properties": {
        "result_id": {
          "const": "eval_result_stage0_rev2_starter_contract"
        },
        "table": {
          "const": "eval_results"
        },
        "fixture_id": {
          "type": "string",
          "pattern": "^fx_[a-z0-9_]+$"
        },
        "final_export_allowed": {
          "type": "boolean"
        },
        "blocking_qa_check_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^qa_[a-z0-9_]+$"
          }
        }
      }
    },
    "trace_step_qa_result_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table",
        "check_ids",
        "coverage_complete"
      ],
      "properties": {
        "table": {
          "const": "qa_results"
        },
        "check_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^qa_[a-z0-9_]+$"
          }
        },
        "coverage_complete": {
          "type": "boolean"
        }
      }
    },
    "safety_decision_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "table",
        "enforcement_point",
        "decision",
        "decision_source",
        "source_rule_ids",
        "audit_required"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "pattern": "^safety_decision_fx_[a-z0-9_]+_(brief|provider_request|provider_response|qa|export)$"
        },
        "table": {
          "const": "safety_decisions"
        },
        "enforcement_point": {
          "enum": [
            "brief",
            "provider_request",
            "provider_response",
            "qa",
            "export"
          ]
        },
        "decision": {
          "enum": [
            "allow",
            "warn",
            "require_user_confirmation",
            "require_admin_review",
            "block"
          ]
        },
        "decision_source": {
          "enum": [
            "default_no_match",
            "linked_safety_rule"
          ]
        },
        "source_rule_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^safety_[a-z0-9_]+$"
          }
        },
        "audit_required": {
          "type": "boolean"
        }
      }
    },
    "artifact_links": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_ids",
        "package_id",
        "export_id",
        "manifest_linked",
        "qa_report_linked",
        "metadata_linked",
        "trace_provenance_linked",
        "safety_disclaimer_linked"
      ],
      "properties": {
        "asset_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^asset_fx_[a-z0-9_]+_candidate_[0-9]+$"
          }
        },
        "package_id": {
          "type": "string",
          "pattern": "^package_fx_[a-z0-9_]+$"
        },
        "export_id": {
          "type": "string",
          "pattern": "^export_fx_[a-z0-9_]+$"
        },
        "manifest_linked": {
          "type": "boolean"
        },
        "qa_report_linked": {
          "type": "boolean"
        },
        "metadata_linked": {
          "type": "boolean"
        },
        "trace_provenance_linked": {
          "type": "boolean"
        },
        "safety_disclaimer_linked": {
          "type": "boolean"
        }
      }
    },
    "negative_trace_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "base_trace_id",
        "mutation",
        "step",
        "expected_error",
        "export_gate_effect",
        "expected_persistence",
        "export_api_projection"
      ],
      "properties": {
        "case_id": {
          "enum": [
            "trace_missing_provider_response_denies_export",
            "trace_out_of_order_export_denies_export",
            "trace_missing_safety_decision_ref_denies_export",
            "trace_missing_qa_result_ref_denies_export",
            "trace_missing_eval_result_export_ref_denies_export",
            "trace_cross_tenant_replay_denies_export"
          ]
        },
        "base_trace_id": {
          "type": "string",
          "pattern": "^trace_[a-z0-9_]+$"
        },
        "mutation": {
          "enum": [
            "remove_step_event",
            "swap_step_order",
            "remove_safety_decision_ref",
            "remove_qa_result_ref",
            "remove_eval_result_ref",
            "cross_tenant_trace_replay"
          ]
        },
        "step": {
          "enum": [
            "brief",
            "provider_request",
            "provider_response",
            "qa",
            "export"
          ]
        },
        "expected_error": {
          "enum": [
            "missing_required_pipeline_step",
            "pipeline_order_violation",
            "missing_safety_decision_ref",
            "missing_qa_result_ref",
            "missing_eval_result_ref",
            "tenant_trace_mismatch"
          ]
        },
        "export_gate_effect": {
          "const": "deny_final_export"
        },
        "expected_persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "export_record_created",
            "downloadable_artifact_created",
            "audit_event_required"
          ],
          "properties": {
            "export_record_created": {
              "const": false
            },
            "downloadable_artifact_created": {
              "const": false
            },
            "audit_event_required": {
              "const": true
            }
          }
        },
        "export_api_projection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "export_id",
            "trace_id",
            "status",
            "final_export_allowed",
            "download_enabled",
            "download_url",
            "denial_reasons",
            "audit_event_required"
          ],
          "properties": {
            "export_id": {
              "type": "string",
              "pattern": "^export_trace_negative_[a-z0-9_]+$"
            },
            "trace_id": {
              "type": "string",
              "pattern": "^trace_[a-z0-9_]+$"
            },
            "status": {
              "const": "blocked"
            },
            "final_export_allowed": {
              "const": false
            },
            "download_enabled": {
              "const": false
            },
            "download_url": {
              "type": "null"
            },
            "denial_reasons": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "trace_missing_required_pipeline_step",
                  "trace_pipeline_order_violation",
                  "trace_missing_safety_decision_ref",
                  "trace_missing_qa_result_ref",
                  "trace_missing_eval_result_ref",
                  "trace_tenant_mismatch"
                ]
              }
            },
            "audit_event_required": {
              "const": true
            }
          }
        }
      }
    }
  }
}
