{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenart.local/schemas/stage0/rev2/workflow_acceptance.schema.json",
  "title": "ZenArt Stage 0 Rev2 Workflow Acceptance Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "display_name",
    "required_inputs",
    "clarification_questions",
    "four_option_taxonomy",
    "required_package_outputs",
    "required_generated_assets",
    "required_qa_checks",
    "required_safety_checks",
    "domain_acceptance_contract",
    "export_targets",
    "negative_fixture_links",
    "negative_guard_coverage_contract",
    "contract_evidence",
    "api_smoke_contract",
    "playwright_happy_path_contract",
    "runtime_evidence_contract",
    "pass_thresholds",
    "golden_fixture",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "stage0.rev2"
    },
    "workflow_id": {
      "enum": [
        "ecommerce_growth_pack",
        "business_visual_doc_pack",
        "local_merchant_campaign_pack",
        "character_ip_concept_pack"
      ]
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "required_inputs": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "type",
          "required"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "text",
              "url",
              "file",
              "enum",
              "number",
              "date"
            ]
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "clarification_questions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "four_option_taxonomy": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_package_outputs": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_generated_assets": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "file_name",
          "asset_kind",
          "strategy_taxonomy",
          "export_target"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "file_name": {
            "type": "string",
            "minLength": 1
          },
          "asset_kind": {
            "enum": [
              "image",
              "document_page",
              "concept_sheet",
              "metadata"
            ]
          },
          "strategy_taxonomy": {
            "type": "string",
            "minLength": 1
          },
          "export_target": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "required_qa_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "file_integrity",
          "dimensions",
          "aspect_ratio",
          "safe_area",
          "blank_output",
          "duplicate_similarity",
          "four_option_distinctness",
          "text_readability",
          "structured_text",
          "product_logo_preservation",
          "forbidden_claims",
          "watermark_signature_risk",
          "export_completeness"
        ]
      }
    },
    "required_safety_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enforcement_points",
        "linked_rule_domains",
        "linked_eval_fixtures"
      ],
      "properties": {
        "enforcement_points": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "brief",
              "provider_request",
              "provider_response",
              "qa",
              "export"
            ]
          }
        },
        "linked_rule_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "linked_eval_fixtures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^fx_[a-z0-9_]+$"
          }
        }
      }
    },
    "domain_acceptance_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_brief_slots",
        "required_strategy_taxonomy",
        "required_package_outputs",
        "required_qa_checks",
        "required_safety_domains",
        "required_export_targets",
        "negative_acceptance_guards"
      ],
      "properties": {
        "required_brief_slots": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        },
        "required_strategy_taxonomy": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_package_outputs": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_qa_checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "file_integrity",
              "dimensions",
              "aspect_ratio",
              "safe_area",
              "blank_output",
              "duplicate_similarity",
              "four_option_distinctness",
              "text_readability",
              "structured_text",
              "product_logo_preservation",
              "forbidden_claims",
              "watermark_signature_risk",
              "export_completeness"
            ]
          }
        },
        "required_safety_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_export_targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        },
        "negative_acceptance_guards": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "export_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "format",
          "required_files"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "format": {
            "enum": [
              "zip",
              "pdf"
            ]
          },
          "required_files": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "negative_fixture_links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "category",
          "expected_status",
          "negative_guard_refs",
          "enforcement_surface",
          "expected_denial_reasons",
          "expected_export_gate_effect"
        ],
        "properties": {
          "fixture_id": {
            "type": "string",
            "pattern": "^fx_[a-z0-9_]+$"
          },
          "category": {
            "enum": [
              "ambiguous_brief",
              "unsafe",
              "negative",
              "brand_product_preservation",
              "text_heavy",
              "export_completeness",
              "red_team"
            ]
          },
          "expected_status": {
            "enum": [
              "pass",
              "blocked",
              "fail"
            ]
          },
          "negative_guard_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          },
          "enforcement_surface": {
            "enum": [
              "clarification",
              "qa",
              "safety",
              "export_completeness"
            ]
          },
          "expected_denial_reasons": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "blocking_qa",
                "safety_policy_block",
                "safety_admin_review_required",
                "safety_user_confirmation_required",
                "incomplete_export_artifacts",
                "qa_coverage_incomplete"
              ]
            }
          },
          "expected_export_gate_effect": {
            "enum": [
              "allow_when_export_contract_complete",
              "allow_with_warning",
              "hold_until_user_confirmation",
              "hold_until_admin_review",
              "block_final_export"
            ]
          }
        }
      }
    },
    "negative_guard_coverage_contract": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "guard_ref",
          "fixture_id",
          "evidence_type",
          "expected_status",
          "expected_final_export_allowed",
          "expected_export_gate_effect",
          "required_qa_check_ids",
          "required_safety_rule_ids",
          "validator"
        ],
        "properties": {
          "guard_ref": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "fixture_id": {
            "type": "string",
            "pattern": "^fx_[a-z0-9_]+$"
          },
          "evidence_type": {
            "enum": [
              "negative_fixture",
              "qa_result",
              "safety_decision"
            ]
          },
          "expected_status": {
            "enum": [
              "pass",
              "blocked",
              "fail"
            ]
          },
          "expected_final_export_allowed": {
            "type": "boolean"
          },
          "expected_export_gate_effect": {
            "enum": [
              "allow_when_export_contract_complete",
              "allow_with_warning",
              "hold_until_user_confirmation",
              "hold_until_admin_review",
              "block_final_export"
            ]
          },
          "required_qa_check_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^qa_[a-z0-9_]+$"
            }
          },
          "required_safety_rule_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^safety_[a-z0-9_]+$"
            }
          },
          "validator": {
            "const": "scripts/validate_workflow_acceptance_contract.py"
          }
        }
      }
    },
    "contract_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eval_result_id",
        "eval_suite_id",
        "golden_fixture_id",
        "golden_eval_status",
        "trace_id",
        "trace_contract_ref",
        "required_trace_fields",
        "required_pipeline_steps",
        "export_contract",
        "qa_export_gate",
        "source_fixtures",
        "validator"
      ],
      "properties": {
        "eval_result_id": {
          "type": "string",
          "pattern": "^eval_result_[a-z0-9_]+$"
        },
        "eval_suite_id": {
          "type": "string",
          "pattern": "^eval_[a-z0-9_]+$"
        },
        "golden_fixture_id": {
          "type": "string",
          "pattern": "^fx_[a-z0-9_]+$"
        },
        "golden_eval_status": {
          "enum": [
            "pass",
            "blocked",
            "fail"
          ]
        },
        "trace_id": {
          "type": "string",
          "pattern": "^trace_[a-z0-9_]+$"
        },
        "trace_contract_ref": {
          "const": "fixtures/stage0/rev2/eval/trace_completeness.json"
        },
        "required_trace_fields": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "schema_validation",
              "provenance",
              "safety_status",
              "qa_eval_status",
              "quota_transaction_id",
              "admin_visibility",
              "user_failure_mapping"
            ]
          }
        },
        "required_pipeline_steps": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "brief",
              "provider_request",
              "provider_response",
              "qa",
              "export"
            ]
          }
        },
        "export_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manifest",
            "qa_report",
            "metadata",
            "trace_provenance",
            "safety_disclaimer_when_applicable",
            "blocks_when_incomplete"
          ],
          "properties": {
            "manifest": {
              "const": true
            },
            "qa_report": {
              "const": true
            },
            "metadata": {
              "const": true
            },
            "trace_provenance": {
              "const": true
            },
            "safety_disclaimer_when_applicable": {
              "const": true
            },
            "blocks_when_incomplete": {
              "const": true
            }
          }
        },
        "qa_export_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "final_export_allowed",
            "export_artifacts_complete",
            "admin_override_required_for_export",
            "override_requires_audit"
          ],
          "properties": {
            "final_export_allowed": {
              "const": false
            },
            "export_artifacts_complete": {
              "const": true
            },
            "admin_override_required_for_export": {
              "const": true
            },
            "override_requires_audit": {
              "const": true
            }
          }
        },
        "source_fixtures": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "fixtures/stage0/rev2/eval/starter_eval_results.json",
              "fixtures/stage0/rev2/eval/starter_eval_suite.json",
              "fixtures/stage0/rev2/eval/trace_completeness.json"
            ]
          }
        },
        "validator": {
          "const": "scripts/validate_workflow_acceptance_contract.py"
        }
      }
    },
    "api_smoke_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_status",
        "blueprint_checklist_remains_open",
        "operation_ids",
        "request_sequence",
        "expected_runtime_assertions"
      ],
      "properties": {
        "execution_status": {
          "const": "not_executed"
        },
        "blueprint_checklist_remains_open": {
          "type": "boolean",
          "const": true
        },
        "operation_ids": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "request_sequence": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step",
              "operation_id",
              "method",
              "path_template",
              "requires_idempotency_key",
              "request_schema",
              "success_status",
              "response_schema",
              "path_params",
              "body_assertions"
            ],
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 1
              },
              "operation_id": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "enum": [
                  "get",
                  "post",
                  "put",
                  "patch",
                  "delete"
                ]
              },
              "path_template": {
                "type": "string",
                "minLength": 1
              },
              "requires_idempotency_key": {
                "type": "boolean"
              },
              "request_schema": {
                "type": "string",
                "minLength": 1
              },
              "success_status": {
                "type": "string",
                "pattern": "^[0-9]{3}$"
              },
              "response_schema": {
                "type": "string",
                "minLength": 1
              },
              "path_params": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "body_assertions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "expected_runtime_assertions": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "playwright_happy_path_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_status",
        "blueprint_checklist_remains_open",
        "start_route",
        "completion_route",
        "expected_user_steps",
        "required_selectors",
        "user_journey",
        "network_assertions",
        "artifact_assertions"
      ],
      "properties": {
        "execution_status": {
          "const": "not_executed"
        },
        "blueprint_checklist_remains_open": {
          "type": "boolean",
          "const": true
        },
        "start_route": {
          "type": "string",
          "pattern": "^/"
        },
        "completion_route": {
          "type": "string",
          "pattern": "^/"
        },
        "expected_user_steps": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_selectors": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\[data-testid="
          }
        },
        "user_journey": {
          "type": "array",
          "minItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step",
              "action",
              "route",
              "selector",
              "assertions"
            ],
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 1
              },
              "action": {
                "enum": [
                  "create_project",
                  "fill_brief",
                  "upload_reference",
                  "confirm_structured_details",
                  "confirm_original_ip_constraints",
                  "generate_candidates",
                  "review_four_candidates",
                  "select_candidate",
                  "iterate_selection",
                  "add_to_package",
                  "preview_export",
                  "download_export"
                ]
              },
              "route": {
                "type": "string",
                "pattern": "^/"
              },
              "selector": {
                "type": "string",
                "pattern": "^\\[data-testid="
              },
              "assertions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "network_assertions": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation_id",
              "method",
              "path_template",
              "success_status"
            ],
            "properties": {
              "operation_id": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "enum": [
                  "get",
                  "post",
                  "put",
                  "patch",
                  "delete"
                ]
              },
              "path_template": {
                "type": "string",
                "pattern": "^/"
              },
              "success_status": {
                "type": "string",
                "pattern": "^[0-9]{3}$"
              }
            }
          }
        },
        "artifact_assertions": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "runtime_evidence_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "release_gate_check_id",
        "release_gate_fixture_ref",
        "required_evidence",
        "required_runtime_assertions",
        "required_export_payloads",
        "blueprint_checklist_items",
        "validator"
      ],
      "properties": {
        "environment": {
          "const": "local_alpha"
        },
        "release_gate_check_id": {
          "const": "local_alpha_e2e_workflow_smoke"
        },
        "release_gate_fixture_ref": {
          "const": "fixtures/stage0/rev2/release_gate_evidence.local_alpha.json"
        },
        "required_evidence": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "path",
              "status",
              "proves_running_local_stack"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "api_smoke",
                  "playwright_happy_path",
                  "export_zip"
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^ops/evidence/local_alpha/[a-z0-9_]+\\.(api_smoke|playwright_happy_path|export_zip)\\.json$"
              },
              "status": {
                "const": "pass"
              },
              "proves_running_local_stack": {
                "const": true
              }
            }
          }
        },
        "required_runtime_assertions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation_count",
            "candidate_count",
            "taxonomy_count",
            "packaged_taxonomy_count",
            "ready_zip_export_count",
            "missing_output_count",
            "qa_taxonomy_status",
            "safety_status",
            "interaction_steps",
            "zip_payload_parity_status"
          ],
          "properties": {
            "operation_count": {
              "const": 8
            },
            "candidate_count": {
              "const": 4
            },
            "taxonomy_count": {
              "const": 4
            },
            "packaged_taxonomy_count": {
              "const": 4
            },
            "ready_zip_export_count": {
              "const": 1
            },
            "missing_output_count": {
              "const": 0
            },
            "qa_taxonomy_status": {
              "const": "pass"
            },
            "safety_status": {
              "const": "pass"
            },
            "interaction_steps": {
              "type": "array",
              "minItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "zip_payload_parity_status": {
              "const": "pass"
            }
          }
        },
        "required_export_payloads": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blueprint_checklist_items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validator": {
          "const": "scripts/validate_workflow_acceptance_contract.py"
        }
      }
    },
    "pass_thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qa",
        "safety",
        "export"
      ],
      "properties": {
        "qa": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blocking_allowed",
            "max_warning_count"
          ],
          "properties": {
            "blocking_allowed": {
              "type": "boolean",
              "const": false
            },
            "max_warning_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_enforcement_points",
            "critical_regression_allowed"
          ],
          "properties": {
            "required_enforcement_points": {
              "type": "array",
              "minItems": 5,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "brief",
                  "provider_request",
                  "provider_response",
                  "qa",
                  "export"
                ]
              }
            },
            "critical_regression_allowed": {
              "type": "boolean",
              "const": false
            }
          }
        },
        "export": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requires_manifest",
            "requires_assets",
            "requires_qa_report",
            "requires_metadata",
            "requires_safety_disclaimer_when_applicable",
            "requires_trace_provenance"
          ],
          "properties": {
            "requires_manifest": {
              "type": "boolean",
              "const": true
            },
            "requires_assets": {
              "type": "boolean",
              "const": true
            },
            "requires_qa_report": {
              "type": "boolean",
              "const": true
            },
            "requires_metadata": {
              "type": "boolean",
              "const": true
            },
            "requires_safety_disclaimer_when_applicable": {
              "type": "boolean",
              "const": true
            },
            "requires_trace_provenance": {
              "type": "boolean",
              "const": true
            }
          }
        }
      }
    },
    "golden_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "brief",
        "expected_candidate_count",
        "expected_export_files"
      ],
      "properties": {
        "fixture_id": {
          "type": "string",
          "pattern": "^fx_[a-z0-9_]+$"
        },
        "brief": {
          "type": "string",
          "minLength": 1
        },
        "expected_candidate_count": {
          "type": "integer",
          "minimum": 4,
          "maximum": 4
        },
        "expected_export_files": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "allOf": [
            {
              "contains": {
                "const": "manifest.json"
              }
            },
            {
              "contains": {
                "const": "metadata.json"
              }
            },
            {
              "contains": {
                "const": "qa_report.json"
              }
            },
            {
              "contains": {
                "const": "trace_provenance.json"
              }
            }
          ]
        }
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blueprint_sections",
        "created_by_lane"
      ],
      "properties": {
        "blueprint_sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^25\\.12$"
          }
        },
        "created_by_lane": {
          "const": "lane6"
        }
      }
    }
  }
}
