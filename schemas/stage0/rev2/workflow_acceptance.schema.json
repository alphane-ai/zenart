{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenart.local/schemas/stage0/rev2/workflow_acceptance.schema.json",
  "title": "ZenArt Stage 0 Rev2 Workflow Acceptance Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "display_name",
    "required_inputs",
    "clarification_questions",
    "four_option_taxonomy",
    "required_package_outputs",
    "required_generated_assets",
    "required_qa_checks",
    "required_safety_checks",
    "export_targets",
    "negative_fixture_links",
    "api_smoke_contract",
    "playwright_happy_path_contract",
    "pass_thresholds",
    "golden_fixture",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "stage0.rev2"
    },
    "workflow_id": {
      "enum": [
        "ecommerce_growth_pack",
        "business_visual_doc_pack",
        "local_merchant_campaign_pack",
        "character_ip_concept_pack"
      ]
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "required_inputs": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "type",
          "required"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "text",
              "url",
              "file",
              "enum",
              "number",
              "date"
            ]
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "clarification_questions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "four_option_taxonomy": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_package_outputs": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_generated_assets": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "file_name",
          "asset_kind",
          "strategy_taxonomy",
          "export_target"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "file_name": {
            "type": "string",
            "minLength": 1
          },
          "asset_kind": {
            "enum": [
              "image",
              "document_page",
              "concept_sheet",
              "metadata"
            ]
          },
          "strategy_taxonomy": {
            "type": "string",
            "minLength": 1
          },
          "export_target": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "required_qa_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "file_integrity",
          "dimensions",
          "aspect_ratio",
          "safe_area",
          "blank_output",
          "duplicate_similarity",
          "four_option_distinctness",
          "text_readability",
          "structured_text",
          "product_logo_preservation",
          "forbidden_claims",
          "watermark_signature_risk",
          "export_completeness"
        ]
      }
    },
    "required_safety_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enforcement_points",
        "linked_rule_domains",
        "linked_eval_fixtures"
      ],
      "properties": {
        "enforcement_points": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "brief",
              "provider_request",
              "provider_response",
              "qa",
              "export"
            ]
          }
        },
        "linked_rule_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "linked_eval_fixtures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^fx_[a-z0-9_]+$"
          }
        }
      }
    },
    "export_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "format",
          "required_files"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "format": {
            "enum": [
              "zip",
              "pdf"
            ]
          },
          "required_files": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "negative_fixture_links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "category",
          "expected_status"
        ],
        "properties": {
          "fixture_id": {
            "type": "string",
            "pattern": "^fx_[a-z0-9_]+$"
          },
          "category": {
            "enum": [
              "ambiguous_brief",
              "unsafe",
              "negative",
              "brand_product_preservation",
              "text_heavy",
              "export_completeness",
              "red_team"
            ]
          },
          "expected_status": {
            "enum": [
              "pass",
              "blocked",
              "fail"
            ]
          }
        }
      }
    },
    "api_smoke_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_status",
        "blueprint_checklist_remains_open",
        "operation_ids",
        "expected_runtime_assertions"
      ],
      "properties": {
        "execution_status": {
          "const": "not_executed"
        },
        "blueprint_checklist_remains_open": {
          "type": "boolean",
          "const": true
        },
        "operation_ids": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_runtime_assertions": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "playwright_happy_path_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_status",
        "blueprint_checklist_remains_open",
        "expected_user_steps"
      ],
      "properties": {
        "execution_status": {
          "const": "not_executed"
        },
        "blueprint_checklist_remains_open": {
          "type": "boolean",
          "const": true
        },
        "expected_user_steps": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "pass_thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qa",
        "safety",
        "export"
      ],
      "properties": {
        "qa": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blocking_allowed",
            "max_warning_count"
          ],
          "properties": {
            "blocking_allowed": {
              "type": "boolean",
              "const": false
            },
            "max_warning_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_enforcement_points",
            "critical_regression_allowed"
          ],
          "properties": {
            "required_enforcement_points": {
              "type": "array",
              "minItems": 5,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "brief",
                  "provider_request",
                  "provider_response",
                  "qa",
                  "export"
                ]
              }
            },
            "critical_regression_allowed": {
              "type": "boolean",
              "const": false
            }
          }
        },
        "export": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requires_manifest",
            "requires_assets",
            "requires_qa_report",
            "requires_metadata",
            "requires_safety_disclaimer_when_applicable",
            "requires_trace_provenance"
          ],
          "properties": {
            "requires_manifest": {
              "type": "boolean",
              "const": true
            },
            "requires_assets": {
              "type": "boolean",
              "const": true
            },
            "requires_qa_report": {
              "type": "boolean",
              "const": true
            },
            "requires_metadata": {
              "type": "boolean",
              "const": true
            },
            "requires_safety_disclaimer_when_applicable": {
              "type": "boolean",
              "const": true
            },
            "requires_trace_provenance": {
              "type": "boolean",
              "const": true
            }
          }
        }
      }
    },
    "golden_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "brief",
        "expected_candidate_count",
        "expected_export_files"
      ],
      "properties": {
        "fixture_id": {
          "type": "string",
          "pattern": "^fx_[a-z0-9_]+$"
        },
        "brief": {
          "type": "string",
          "minLength": 1
        },
        "expected_candidate_count": {
          "type": "integer",
          "minimum": 4,
          "maximum": 4
        },
        "expected_export_files": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blueprint_sections",
        "created_by_lane"
      ],
      "properties": {
        "blueprint_sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^25\\.12$"
          }
        },
        "created_by_lane": {
          "const": "lane6"
        }
      }
    }
  }
}
