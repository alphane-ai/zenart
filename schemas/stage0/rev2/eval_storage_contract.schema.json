{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenart.local/schemas/stage0/rev2/eval_storage_contract.schema.json",
  "title": "ZenArt Stage 0 Rev2 Eval Storage Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "blueprint_source",
    "stored_result_fixture",
    "table_contract",
    "write_contract",
    "write_fixture_contract",
    "read_contract",
    "read_fixture_contract",
    "replay_contract",
    "retention_contract",
    "release_gate_contract",
    "openapi_contract",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "stage0.rev2"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^eval_storage_contract_[a-z0-9_]+$"
    },
    "blueprint_source": {
      "const": "Docs/stage0_blueprint_rev2.md"
    },
    "stored_result_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "result_id",
        "suite_id",
        "status",
        "candidate_status_after_eval",
        "runner_sha256_required"
      ],
      "properties": {
        "path": {
          "const": "fixtures/stage0/rev2/eval/starter_eval_results.json"
        },
        "result_id": {
          "type": "string",
          "pattern": "^eval_result_[a-z0-9_]+$"
        },
        "suite_id": {
          "type": "string",
          "pattern": "^eval_[a-z0-9_]+$"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "blocked"
          ]
        },
        "candidate_status_after_eval": {
          "enum": [
            "draft",
            "eligible_for_canary",
            "eligible_for_active",
            "blocked"
          ]
        },
        "runner_sha256_required": {
          "const": true
        }
      }
    },
    "table_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table",
        "required_columns",
        "required_indexes",
        "tenant_scoped",
        "subject_scoped",
        "summary_json_contains_fixture_results",
        "summary_projection_fields",
        "fixture_result_projection_fields",
        "admin_read_projection_required",
        "read_without_eval_rerun",
        "latest_result_resolvable",
        "immutable_rows",
        "idempotent_replay_key",
        "retention_contract_ref",
        "no_public_delete_operation"
      ],
      "properties": {
        "table": {
          "const": "eval_results"
        },
        "required_columns": {
          "type": "array",
          "minItems": 12,
          "uniqueItems": true,
          "items": {
            "enum": [
              "id",
              "tenant_id",
              "eval_suite_id",
              "subject_type",
              "subject_id",
              "subject_version",
              "status",
              "summary",
              "runner",
              "runner_sha256",
              "completed_at",
              "created_at"
            ]
          }
        },
        "required_indexes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "idx_eval_results_tenant_suite_subject_created_at",
              "idx_eval_results_subject_status_completed_at"
            ]
          }
        },
        "tenant_scoped": {
          "const": true
        },
        "subject_scoped": {
          "const": true
        },
        "summary_json_contains_fixture_results": {
          "const": true
        },
        "summary_projection_fields": {
          "$ref": "#/$defs/summary_projection_fields"
        },
        "fixture_result_projection_fields": {
          "$ref": "#/$defs/fixture_result_projection_fields"
        },
        "admin_read_projection_required": {
          "const": true
        },
        "read_without_eval_rerun": {
          "const": true
        },
        "latest_result_resolvable": {
          "const": true
        },
        "immutable_rows": {
          "const": true
        },
        "idempotent_replay_key": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "tenant_id",
              "eval_suite_id",
              "subject_type",
              "subject_id",
              "subject_version",
              "runner_sha256"
            ]
          }
        },
        "retention_contract_ref": {
          "const": "retention_contract"
        },
        "no_public_delete_operation": {
          "const": true
        }
      }
    },
    "write_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "write_command",
        "writes_stored_fixture",
        "persists_runner_sha256",
        "persists_completed_at",
        "persists_subject_version",
        "idempotency_key_fields",
        "transaction_boundary"
      ],
      "properties": {
        "runner": {
          "const": "scripts/run_stage0_eval.py"
        },
        "write_command": {
          "const": "python3 scripts/run_stage0_eval.py --write"
        },
        "writes_stored_fixture": {
          "const": true
        },
        "persists_runner_sha256": {
          "const": true
        },
        "persists_completed_at": {
          "const": true
        },
        "persists_subject_version": {
          "const": true
        },
        "idempotency_key_fields": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "tenant_id",
              "eval_suite_id",
              "subject_type",
              "subject_id",
              "subject_version",
              "runner_sha256"
            ]
          }
        },
        "transaction_boundary": {
          "enum": [
            "single_eval_result_insert",
            "single_eval_result_upsert"
          ]
        }
      }
    },
    "write_fixture_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotency_key_fields",
        "result_digest_fields",
        "mutation_guards",
        "cases"
      ],
      "properties": {
        "idempotency_key_fields": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "tenant_id",
              "eval_suite_id",
              "subject_type",
              "subject_id",
              "subject_version",
              "runner_sha256"
            ]
          }
        },
        "result_digest_fields": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "status",
              "summary",
              "fixture_results",
              "completed_at",
              "source_fixture_digests"
            ]
          }
        },
        "mutation_guards": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exact_replay_must_not_update_completed_at",
            "divergent_replay_must_not_overwrite_existing_row",
            "tenant_isolation_partitions_idempotency_key",
            "conflict_row_requires_admin_audit_before_retry",
            "source_fixture_digest_change_rejected_under_same_key"
          ],
          "properties": {
            "exact_replay_must_not_update_completed_at": {
              "const": true
            },
            "divergent_replay_must_not_overwrite_existing_row": {
              "const": true
            },
            "tenant_isolation_partitions_idempotency_key": {
              "const": true
            },
            "conflict_row_requires_admin_audit_before_retry": {
              "const": true
            },
            "source_fixture_digest_change_rejected_under_same_key": {
              "const": true
            }
          }
        },
        "cases": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/write_fixture_case"
          }
        }
      }
    },
    "read_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "list_operation_id",
        "read_runner",
        "check_command",
        "required_query_filters",
        "admin_rbac_required",
        "tenant_filter_required",
        "latest_result_order",
        "stable_tie_break_order",
        "subject_latest_resolution",
        "page_schema"
      ],
      "properties": {
        "list_operation_id": {
          "const": "listEvalResults"
        },
        "read_runner": {
          "const": "scripts/run_eval_storage_read_contract.py"
        },
        "check_command": {
          "const": "python3 scripts/run_eval_storage_read_contract.py --check"
        },
        "required_query_filters": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "tenant_id",
              "eval_suite_id",
              "subject_type",
              "subject_id",
              "status",
              "completed_after",
              "latest_only"
            ]
          }
        },
        "admin_rbac_required": {
          "const": true
        },
        "tenant_filter_required": {
          "const": true
        },
        "latest_result_order": {
          "const": "completed_at_desc"
        },
        "stable_tie_break_order": {
          "const": "created_at_desc"
        },
        "subject_latest_resolution": {
          "const": "tenant_suite_subject_version_runner_hash"
        },
        "page_schema": {
          "const": "EvalResultPage"
        }
      }
    },
    "read_fixture_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_filter_required",
        "ordering",
        "latest_only_groups_by",
        "fixture_rows",
        "cases",
        "expected_empty_cases"
      ],
      "properties": {
        "tenant_filter_required": {
          "const": true
        },
        "ordering": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "enum": [
              "completed_at_desc",
              "created_at_desc"
            ]
          }
        },
        "latest_only_groups_by": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "tenant_id",
              "eval_suite_id",
              "subject_type",
              "subject_id",
              "subject_version",
              "runner_sha256"
            ]
          }
        },
        "fixture_rows": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/read_fixture_row"
          }
        },
        "cases": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/read_fixture_case"
          }
        },
        "expected_empty_cases": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/read_fixture_case"
          }
        }
      }
    },
    "replay_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_command",
        "check_mode_compares_exact_json",
        "runner_sha256_matches_runner_file",
        "source_fixtures",
        "source_fixture_digests_required"
      ],
      "properties": {
        "check_command": {
          "const": "python3 scripts/run_stage0_eval.py --check"
        },
        "check_mode_compares_exact_json": {
          "const": true
        },
        "runner_sha256_matches_runner_file": {
          "const": true
        },
        "source_fixtures": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_fixture_digests_required": {
          "const": true
        }
      }
    },
    "retention_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retain_pass_fail_blocked_results",
        "retain_summary_json",
        "retain_runner_hash",
        "deletion_requires_admin_audit",
        "redaction_requires_admin_audit",
        "no_public_delete_operation",
        "minimum_retention_days"
      ],
      "properties": {
        "retain_pass_fail_blocked_results": {
          "const": true
        },
        "retain_summary_json": {
          "const": true
        },
        "retain_runner_hash": {
          "const": true
        },
        "deletion_requires_admin_audit": {
          "const": true
        },
        "redaction_requires_admin_audit": {
          "const": true
        },
        "no_public_delete_operation": {
          "const": true
        },
        "minimum_retention_days": {
          "type": "integer",
          "minimum": 365
        }
      }
    },
    "release_gate_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_contract_fixture",
        "requires_eval_pass_for_skill_canary",
        "requires_eval_pass_for_skill_active",
        "requires_eval_pass_for_prompt_fragment_active",
        "blocked_result_denies_activation"
      ],
      "properties": {
        "activation_contract_fixture": {
          "const": "fixtures/stage0/rev2/eval/activation_gate_contract.json"
        },
        "requires_eval_pass_for_skill_canary": {
          "const": true
        },
        "requires_eval_pass_for_skill_active": {
          "const": true
        },
        "requires_eval_pass_for_prompt_fragment_active": {
          "const": true
        },
        "blocked_result_denies_activation": {
          "const": true
        }
      }
    },
    "openapi_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "operation_id",
        "response_schema",
        "rbac",
        "required_parameters"
      ],
      "properties": {
        "path": {
          "const": "/eval/results"
        },
        "operation_id": {
          "const": "listEvalResults"
        },
        "response_schema": {
          "const": "EvalResultPage"
        },
        "rbac": {
          "const": "admin"
        },
        "required_parameters": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "TenantIdFilter",
              "StatusFilter",
              "EvalSuiteIdFilter",
              "EvalSubjectTypeFilter",
              "SubjectIdFilter",
              "CompletedAfterFilter",
              "EvalLatestOnlyFilter"
            ]
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blueprint_sections",
        "created_by_lane"
      ],
      "properties": {
        "blueprint_sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^((14|15|25)\\.|24$)"
          }
        },
        "created_by_lane": {
          "const": "lane2"
        }
      }
    }
  },
  "$defs": {
    "summary_projection_fields": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {
        "enum": [
          "total_fixtures",
          "passed_fixtures",
          "failed_fixtures",
          "blocked_fixtures",
          "golden_passed",
          "critical_safety_regressions",
          "regression_pass_rate",
          "trace_complete",
          "export_contract_complete",
          "qa_fixture_coverage_complete",
          "qa_categories_covered",
          "safety_enforcement_points_covered"
        ]
      }
    },
    "fixture_result_projection_fields": {
      "type": "array",
      "minItems": 13,
      "uniqueItems": true,
      "items": {
        "enum": [
          "fixture_id",
          "category",
          "workflow",
          "status",
          "expected_safety_action",
          "observed_safety_action",
          "safety_decision_contract",
          "qa_check_ids",
          "qa_coverage_contract",
          "trace_contract",
          "export_contract",
          "qa_export_gate",
          "failure_reasons"
        ]
      }
    },
    "read_fixture_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tenant_id",
        "eval_suite_id",
        "subject_type",
        "subject_id",
        "subject_version",
        "runner_sha256",
        "status",
        "completed_at",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^eval_result_[a-z0-9_]+$"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^tenant_[a-z0-9_]+$"
        },
        "eval_suite_id": {
          "type": "string",
          "pattern": "^eval_[a-z0-9_]+$"
        },
        "subject_type": {
          "enum": [
            "skill_version",
            "prompt_fragment",
            "prompt_mutation",
            "meta_prompt",
            "image_spec",
            "vertical_workflow_pack"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_version": {
          "type": "string",
          "minLength": 1
        },
        "runner_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "blocked"
          ]
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "read_fixture_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "query",
        "expected_result_ids"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "query": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tenant_id",
            "latest_only"
          ],
          "properties": {
            "tenant_id": {
              "type": "string",
              "pattern": "^tenant_[a-z0-9_]+$"
            },
            "eval_suite_id": {
              "type": "string",
              "pattern": "^eval_[a-z0-9_]+$"
            },
            "subject_type": {
              "enum": [
                "skill_version",
                "prompt_fragment",
                "prompt_mutation",
                "meta_prompt",
                "image_spec",
                "vertical_workflow_pack"
              ]
            },
            "subject_id": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "pass",
                "fail",
                "blocked"
              ]
            },
            "completed_after": {
              "type": "string",
              "format": "date-time"
            },
            "latest_only": {
              "type": "boolean"
            }
          }
        },
        "expected_result_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^eval_result_[a-z0-9_]+$"
          }
        }
      }
    },
    "write_fixture_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "eval_suite_id",
        "subject_type",
        "subject_id",
        "subject_version",
        "runner_sha256",
        "status",
        "summary_sha256",
        "fixture_results_sha256",
        "completed_at",
        "source_fixture_digests_sha256"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "pattern": "^tenant_[a-z0-9_]+$"
        },
        "eval_suite_id": {
          "type": "string",
          "pattern": "^eval_[a-z0-9_]+$"
        },
        "subject_type": {
          "enum": [
            "skill_version",
            "prompt_fragment",
            "prompt_mutation",
            "meta_prompt",
            "image_spec",
            "vertical_workflow_pack"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_version": {
          "type": "string",
          "minLength": 1
        },
        "runner_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "blocked"
          ]
        },
        "summary_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fixture_results_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_fixture_digests_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "write_fixture_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "existing_row",
        "attempted_write",
        "expected_outcome"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "existing_row": {
          "$ref": "#/$defs/write_fixture_row"
        },
        "attempted_write": {
          "$ref": "#/$defs/write_fixture_row"
        },
        "expected_outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "stored_row_source",
            "requires_admin_audit",
            "activation_allowed",
            "reason"
          ],
          "properties": {
            "action": {
              "enum": [
                "return_existing_row",
                "insert_new_row",
                "reject_conflict"
              ]
            },
            "stored_row_source": {
              "enum": [
                "existing_row",
                "attempted_write",
                "none"
              ]
            },
            "requires_admin_audit": {
              "type": "boolean"
            },
            "activation_allowed": {
              "type": "boolean"
            },
            "reason": {
              "enum": [
                "exact_idempotent_replay",
                "cross_tenant_insert_allowed",
                "divergent_replay_summary_conflict",
                "source_fixture_digest_conflict"
              ]
            }
          }
        }
      }
    }
  }
}
