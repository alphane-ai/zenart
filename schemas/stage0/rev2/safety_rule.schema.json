{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenart.local/schemas/stage0/rev2/safety_rule.schema.json",
  "title": "ZenArt Stage 0 Rev2 Safety Rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rule_id",
    "version",
    "domain",
    "severity",
    "enforcement_points",
    "action",
    "user_message",
    "admin_override_eligible",
    "audit_required",
    "eval_fixture_links",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "stage0.rev2"
    },
    "rule_id": {
      "type": "string",
      "pattern": "^safety_[a-z0-9_]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "domain": {
      "enum": [
        "legal",
        "medical",
        "financial",
        "compliance",
        "industrial_safety",
        "ecommerce_claims",
        "ip_brand",
        "adult_minor"
      ]
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "enforcement_points": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "brief",
          "provider_request",
          "provider_response",
          "qa",
          "export"
        ]
      }
    },
    "action": {
      "enum": [
        "allow",
        "warn",
        "require_user_confirmation",
        "require_admin_review",
        "block"
      ]
    },
    "user_message": {
      "type": "string",
      "minLength": 1
    },
    "admin_override_eligible": {
      "type": "boolean"
    },
    "audit_required": {
      "type": "boolean"
    },
    "eval_fixture_links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^fx_[a-z0-9_]+$"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blueprint_sections",
        "created_by_lane"
      ],
      "properties": {
        "blueprint_sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^15\\.3$"
          }
        },
        "created_by_lane": {
          "const": "lane6"
        }
      }
    }
  }
}
