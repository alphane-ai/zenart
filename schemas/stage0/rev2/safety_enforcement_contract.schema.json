{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenari.local/schemas/stage0/rev2/safety_enforcement_contract.schema.json",
  "title": "Zenari Stage 0 Rev2 Safety Enforcement Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "blueprint_source",
    "required_enforcement_points",
    "decision_storage_contract",
    "decision_redaction_contract",
    "runtime_contracts",
    "pipeline_sequence_contract",
    "runtime_replay_contract",
    "export_artifact_prevention_contract",
    "decision_matrix",
    "fixture_links",
    "release_gate_policy",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "stage0.rev2"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^safety_enforcement_contract_[a-z0-9_]+$"
    },
    "blueprint_source": {
      "const": "Docs/stage0_blueprint_rev2.md"
    },
    "required_enforcement_points": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "brief",
          "provider_request",
          "provider_response",
          "qa",
          "export"
        ]
      }
    },
    "decision_storage_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table",
        "required_columns",
        "tenant_scoped",
        "audit_rationale_required"
      ],
      "properties": {
        "table": {
          "const": "safety_decisions"
        },
        "required_columns": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "id",
              "tenant_id",
              "rule_id",
              "subject_type",
              "subject_id",
              "enforcement_point",
              "decision",
              "rationale",
              "created_at"
            ]
          }
        },
        "tenant_scoped": {
          "const": true
        },
        "audit_rationale_required": {
          "const": true
        }
      }
    },
    "decision_redaction_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rationale_policy",
        "allowed_rationale_sources",
        "forbidden_rationale_inputs",
        "analytics_payload_policy",
        "redaction_test_evidence",
        "runtime_replay_cases"
      ],
      "properties": {
        "rationale_policy": {
          "const": "system_generated_only_no_raw_subject_payload"
        },
        "allowed_rationale_sources": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "no_active_safety_rule_matched",
              "active_safety_rule_matched_enforcement_point"
            ]
          }
        },
        "forbidden_rationale_inputs": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "brief_text",
              "provider_request_body",
              "provider_response_body",
              "qa_observed_text",
              "export_manifest",
              "download_url",
              "api_key",
              "session_token",
              "authorization_header"
            ]
          }
        },
        "analytics_payload_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_name",
            "allowed_properties",
            "forbidden_properties"
          ],
          "properties": {
            "event_name": {
              "const": "safety_decision_recorded"
            },
            "allowed_properties": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "enforcement_point",
                  "decision",
                  "rule_id"
                ]
              }
            },
            "forbidden_properties": {
              "type": "array",
              "minItems": 6,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "brief_text",
                  "provider_request_body",
                  "provider_response_body",
                  "qa_observed_text",
                  "export_manifest",
                  "download_url",
                  "api_key",
                  "session_token",
                  "authorization_header"
                ]
              }
            }
          }
        },
        "redaction_test_evidence": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runtime_replay_cases": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "input_surface",
              "secret_or_payload_input",
              "stored_rationale",
              "analytics_properties",
              "forbidden_output_fragments",
              "expected_result"
            ],
            "properties": {
              "case_id": {
                "type": "string",
                "pattern": "^safety_decision_redaction_[a-z0-9_]+$"
              },
              "input_surface": {
                "enum": [
                  "brief",
                  "provider_request",
                  "provider_response",
                  "qa",
                  "export"
                ]
              },
              "secret_or_payload_input": {
                "type": "string",
                "minLength": 1
              },
              "stored_rationale": {
                "enum": [
                  "no active safety rule matched",
                  "active safety rule matched enforcement point"
                ]
              },
              "analytics_properties": {
                "type": "array",
                "minItems": 3,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "enforcement_point",
                    "decision",
                    "rule_id"
                  ]
                }
              },
              "forbidden_output_fragments": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "expected_result": {
                "const": "redacted_or_not_persisted"
              }
            }
          }
        }
      }
    },
    "runtime_contracts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enforcement_point",
          "subject_types",
          "required_decision_actions",
          "trace_status_required",
          "blocks_export_when_blocking",
          "openapi_operation",
          "backend_evidence"
        ],
        "properties": {
          "enforcement_point": {
            "enum": [
              "brief",
              "provider_request",
              "provider_response",
              "qa",
              "export"
            ]
          },
          "subject_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "brief",
                "provider_request",
                "provider_response",
                "qa_result",
                "asset",
                "package",
                "export"
              ]
            }
          },
          "required_decision_actions": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "allow",
                "warn",
                "require_user_confirmation",
                "require_admin_review",
                "block"
              ]
            }
          },
          "trace_status_required": {
            "const": true
          },
          "blocks_export_when_blocking": {
            "type": "boolean"
          },
          "openapi_operation": {
            "enum": [
              "createSafetyDecision"
            ]
          },
          "backend_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "pipeline_sequence_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordered_enforcement_points",
        "transition_gates",
        "fail_closed_cases",
        "bypass_prevention_cases",
        "override_downgrade_prevention_cases",
        "effective_decision_precedence_cases"
      ],
      "properties": {
        "ordered_enforcement_points": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "enum": [
              "brief",
              "provider_request",
              "provider_response",
              "qa",
              "export"
            ]
          }
        },
        "transition_gates": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "enforcement_point",
              "must_run_before",
              "required_subject_fields",
              "blocked_or_held_effect",
              "downstream_artifacts_created_on_block",
              "trace_status_required"
            ],
            "properties": {
              "stage": {
                "enum": [
                  "brief_completion",
                  "provider_request_dispatch",
                  "provider_response_acceptance",
                  "qa_completion",
                  "export_creation",
                  "export_artifact_recording"
                ]
              },
              "enforcement_point": {
                "enum": [
                  "brief",
                  "provider_request",
                  "provider_response",
                  "qa",
                  "export"
                ]
              },
              "must_run_before": {
                "enum": [
                  "brief_confirmed",
                  "provider_call",
                  "candidate_asset_acceptance",
                  "package_export_allowed",
                  "export_task_created",
                  "downloadable_artifact_recorded"
                ]
              },
              "required_subject_fields": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "tenant_id",
                    "project_id",
                    "task_id",
                    "qa_subject_type",
                    "qa_subject_id",
                    "export_id"
                  ]
                }
              },
              "blocked_or_held_effect": {
                "enum": [
                  "deny_generation",
                  "deny_provider_call",
                  "deny_asset_acceptance",
                  "deny_qa_completion",
                  "deny_export_task",
                  "deny_downloadable_artifact"
                ]
              },
              "downstream_artifacts_created_on_block": {
                "const": false
              },
              "trace_status_required": {
                "const": true
              }
            }
          }
        },
        "fail_closed_cases": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "input_gap",
              "expected_error",
              "creates_downstream_artifacts",
              "decision_rows_required_before_error"
            ],
            "properties": {
              "case_id": {
                "type": "string",
                "pattern": "^safety_[a-z0-9_]+$"
              },
              "input_gap": {
                "enum": [
                  "missing_tenant_id",
                  "missing_all_subjects",
                  "blocked_export_rule",
                  "held_review_decision"
                ]
              },
              "expected_error": {
                "enum": [
                  "ErrValidation",
                  "ErrSafetyBlocked",
                  "ErrSafetyReviewHold"
                ]
              },
              "creates_downstream_artifacts": {
                "const": false
              },
              "decision_rows_required_before_error": {
                "type": "boolean"
              }
            }
          }
        },
        "bypass_prevention_cases": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "transition_stage",
              "attempted_bypass",
              "skipped_enforcement_point",
              "attempted_downstream_transition",
              "expected_error",
              "creates_downstream_artifacts",
              "trace_status_required",
              "backend_evidence"
            ],
            "properties": {
              "case_id": {
                "type": "string",
                "pattern": "^safety_bypass_[a-z0-9_]+_denied$"
              },
              "transition_stage": {
                "enum": [
                  "brief_completion",
                  "provider_request_dispatch",
                  "provider_response_acceptance",
                  "qa_completion",
                  "export_creation",
                  "export_artifact_recording"
                ]
              },
              "attempted_bypass": {
                "enum": [
                  "confirm_brief_without_policy_decision",
                  "call_provider_without_provider_request_policy_decision",
                  "accept_asset_without_provider_response_policy_decision",
                  "mark_qa_complete_without_qa_policy_decision",
                  "create_export_task_without_export_policy_decision",
                  "record_downloadable_artifact_without_export_policy_decision"
                ]
              },
              "skipped_enforcement_point": {
                "enum": [
                  "brief",
                  "provider_request",
                  "provider_response",
                  "qa",
                  "export"
                ]
              },
              "attempted_downstream_transition": {
                "enum": [
                  "brief_confirmed",
                  "provider_call",
                  "candidate_asset_acceptance",
                  "package_export_allowed",
                  "export_task_created",
                  "downloadable_artifact_recorded"
                ]
              },
              "expected_error": {
                "enum": [
                  "ErrValidation",
                  "ErrSafetyBlocked",
                  "ErrSafetyReviewHold"
                ]
              },
              "creates_downstream_artifacts": {
                "const": false
              },
              "trace_status_required": {
                "const": true
              },
              "backend_evidence": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "override_downgrade_prevention_cases": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "fixture_id",
              "original_decision",
              "attempted_override_decision",
              "attempted_export_gate",
              "expected_error",
              "final_export_allowed",
              "requires_admin_audit",
              "creates_downstream_artifacts",
              "trace_status_required",
              "persisted_original_decision_required"
            ],
            "properties": {
              "case_id": {
                "type": "string",
                "pattern": "^safety_override_[a-z0-9_]+_denied$"
              },
              "fixture_id": {
                "type": "string",
                "pattern": "^fx_[a-z0-9_]+$"
              },
              "original_decision": {
                "enum": [
                  "require_user_confirmation",
                  "require_admin_review",
                  "block"
                ]
              },
              "attempted_override_decision": {
                "enum": [
                  "allow",
                  "warn",
                  "require_admin_review"
                ]
              },
              "attempted_export_gate": {
                "enum": [
                  "allow_when_export_contract_complete",
                  "allow_with_warning",
                  "hold_until_admin_review"
                ]
              },
              "expected_error": {
                "enum": [
                  "ErrSafetyBlocked",
                  "ErrSafetyReviewHold"
                ]
              },
              "final_export_allowed": {
                "const": false
              },
              "requires_admin_audit": {
                "const": true
              },
              "creates_downstream_artifacts": {
                "const": false
              },
              "trace_status_required": {
                "const": true
              },
              "persisted_original_decision_required": {
                "const": true
              }
            }
          }
        },
        "effective_decision_precedence_cases": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "per_point_decisions",
              "expected_effective_decision",
              "expected_export_gate",
              "final_export_allowed",
              "requires_audit",
              "trace_status_required",
              "persisted_decision_required",
              "creates_downstream_artifacts"
            ],
            "properties": {
              "case_id": {
                "type": "string",
                "pattern": "^safety_effective_[a-z0-9_]+$"
              },
              "per_point_decisions": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "brief",
                  "provider_request",
                  "provider_response",
                  "qa",
                  "export"
                ],
                "properties": {
                  "brief": {
                    "$ref": "#/$defs/safety_action"
                  },
                  "provider_request": {
                    "$ref": "#/$defs/safety_action"
                  },
                  "provider_response": {
                    "$ref": "#/$defs/safety_action"
                  },
                  "qa": {
                    "$ref": "#/$defs/safety_action"
                  },
                  "export": {
                    "$ref": "#/$defs/safety_action"
                  }
                }
              },
              "expected_effective_decision": {
                "$ref": "#/$defs/safety_action"
              },
              "expected_export_gate": {
                "enum": [
                  "allow_when_export_contract_complete",
                  "allow_with_warning",
                  "hold_until_user_confirmation",
                  "hold_until_admin_review",
                  "block_final_export"
                ]
              },
              "final_export_allowed": {
                "type": "boolean"
              },
              "requires_audit": {
                "type": "boolean"
              },
              "trace_status_required": {
                "const": true
              },
              "persisted_decision_required": {
                "const": true
              },
              "creates_downstream_artifacts": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "decision_matrix": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enforcement_point",
          "actions"
        ],
        "properties": {
          "enforcement_point": {
            "enum": [
              "brief",
              "provider_request",
              "provider_response",
              "qa",
              "export"
            ]
          },
          "actions": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "decision",
                "source_fixture_id",
                "source_rule_id",
                "export_gate",
                "requires_trace_safety_status",
                "requires_persisted_decision",
                "requires_audit",
                "user_visible_outcome"
              ],
              "properties": {
                "decision": {
                  "enum": [
                    "allow",
                    "warn",
                    "require_user_confirmation",
                    "require_admin_review",
                    "block"
                  ]
                },
                "source_fixture_id": {
                  "type": "string",
                  "pattern": "^fx_[a-z0-9_]+$"
                },
                "source_rule_id": {
                  "type": "string",
                  "minLength": 1
                },
                "export_gate": {
                  "enum": [
                    "allow_when_export_contract_complete",
                    "allow_with_warning",
                    "hold_until_user_confirmation",
                    "hold_until_admin_review",
                    "block_final_export"
                  ]
                },
                "requires_trace_safety_status": {
                  "const": true
                },
                "requires_persisted_decision": {
                  "const": true
                },
                "requires_audit": {
                  "type": "boolean"
                },
                "user_visible_outcome": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "runtime_replay_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "mode",
        "status",
        "transition_gate_cases_replayed",
        "decision_matrix_cases_replayed",
        "fail_closed_cases_replayed",
        "bypass_prevention_cases_replayed",
        "override_downgrade_cases_replayed",
        "effective_decision_precedence_cases_replayed",
        "fixture_link_cases_replayed",
        "fixture_link_point_decision_refs_replayed",
        "decision_redaction_cases_replayed",
        "export_artifact_prevention_cases_replayed",
        "transition_points_replayed",
        "decision_priority_order_validated",
        "decision_rationale_sources_validated",
        "analytics_payload_minimized",
        "held_or_blocked_require_audit_for_all_actions",
        "effective_decision_precedence_validated",
        "blocked_or_held_creates_downstream_artifacts",
        "trace_status_required_for_all_transitions",
        "persisted_decision_required_for_all_actions",
        "trace_decision_refs_replayed"
      ],
      "properties": {
        "runner": {
          "const": "scripts/run_safety_policy_runtime_contract.py"
        },
        "mode": {
          "const": "deterministic_fixture_replay"
        },
        "status": {
          "const": "pass"
        },
        "transition_gate_cases_replayed": {
          "type": "integer",
          "minimum": 6
        },
        "decision_matrix_cases_replayed": {
          "type": "integer",
          "minimum": 25
        },
        "fail_closed_cases_replayed": {
          "type": "integer",
          "minimum": 4
        },
        "bypass_prevention_cases_replayed": {
          "type": "integer",
          "minimum": 6
        },
        "override_downgrade_cases_replayed": {
          "type": "integer",
          "minimum": 4
        },
        "effective_decision_precedence_cases_replayed": {
          "type": "integer",
          "minimum": 5
        },
        "fixture_link_cases_replayed": {
          "type": "integer",
          "minimum": 4
        },
        "fixture_link_point_decision_refs_replayed": {
          "type": "integer",
          "minimum": 20
        },
        "decision_redaction_cases_replayed": {
          "type": "integer",
          "minimum": 4
        },
        "export_artifact_prevention_cases_replayed": {
          "type": "integer",
          "minimum": 4
        },
        "transition_points_replayed": {
          "const": true
        },
        "decision_priority_order_validated": {
          "const": true
        },
        "decision_rationale_sources_validated": {
          "const": true
        },
        "analytics_payload_minimized": {
          "const": true
        },
        "held_or_blocked_require_audit_for_all_actions": {
          "const": true
        },
        "effective_decision_precedence_validated": {
          "const": true
        },
        "blocked_or_held_creates_downstream_artifacts": {
          "const": false
        },
        "trace_status_required_for_all_transitions": {
          "const": true
        },
        "persisted_decision_required_for_all_actions": {
          "const": true
        },
        "trace_decision_refs_replayed": {
          "const": true
        }
      }
    },
    "export_artifact_prevention_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "artifact_recording_transition",
        "required_eval_gate_fields",
        "required_trace_export_refs",
        "prevention_cases"
      ],
      "properties": {
        "policy": {
          "const": "held_or_blocked_safety_or_incomplete_export_contract_prevents_downloadable_artifact"
        },
        "artifact_recording_transition": {
          "const": "export_artifact_recording"
        },
        "required_eval_gate_fields": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "final_export_allowed",
              "safety_blocks_export",
              "export_artifacts_complete",
              "denial_reasons",
              "override_requires_audit"
            ]
          }
        },
        "required_trace_export_refs": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "manifest",
              "qa_report",
              "metadata",
              "trace_provenance",
              "safety_disclaimer_when_applicable"
            ]
          }
        },
        "prevention_cases": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "fixture_id",
              "trace_id",
              "effective_decision",
              "expected_error",
              "expected_denial_reasons",
              "missing_export_artifacts",
              "downloadable_artifact_recorded",
              "object_metadata_created",
              "tenant_signed_download_created",
              "override_requires_audit",
              "trace_export_references_required"
            ],
            "properties": {
              "case_id": {
                "type": "string",
                "pattern": "^safety_prevent_artifact_when_[a-z0-9_]+$"
              },
              "fixture_id": {
                "type": "string",
                "pattern": "^fx_[a-z0-9_]+$"
              },
              "trace_id": {
                "type": "string",
                "pattern": "^trace_[a-z0-9_]+$"
              },
              "effective_decision": {
                "enum": [
                  "require_user_confirmation",
                  "require_admin_review",
                  "block"
                ]
              },
              "expected_error": {
                "enum": [
                  "ErrSafetyBlocked",
                  "ErrSafetyReviewHold"
                ]
              },
              "expected_denial_reasons": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "blocking_qa",
                    "safety_policy_block",
                    "safety_user_confirmation_required",
                    "safety_admin_review_required",
                    "incomplete_export_artifacts",
                    "qa_coverage_incomplete"
                  ]
                }
              },
              "missing_export_artifacts": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "manifest",
                    "metadata"
                  ]
                }
              },
              "downloadable_artifact_recorded": {
                "const": false
              },
              "object_metadata_created": {
                "const": false
              },
              "tenant_signed_download_created": {
                "const": false
              },
              "override_requires_audit": {
                "const": true
              },
              "trace_export_references_required": {
                "const": true
              }
            }
          }
        }
      }
    },
    "fixture_links": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "trace_id",
          "expected_safety_action",
          "expected_decision_source",
          "expected_source_rule_ids",
          "required_enforcement_points",
          "per_point_decision_refs",
          "must_block_final_export"
        ],
        "properties": {
          "fixture_id": {
            "type": "string",
            "pattern": "^fx_[a-z0-9_]+$"
          },
          "trace_id": {
            "type": "string",
            "pattern": "^trace_[a-z0-9_]+$"
          },
          "expected_safety_action": {
            "enum": [
              "block",
              "require_user_confirmation",
              "require_admin_review",
              "warn"
            ]
          },
          "expected_decision_source": {
            "const": "linked_safety_rule"
          },
          "expected_source_rule_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^safety_[a-z0-9_]+$"
            }
          },
          "required_enforcement_points": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "enum": [
                "brief",
                "provider_request",
                "provider_response",
                "qa",
                "export"
              ]
            }
          },
          "per_point_decision_refs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "brief",
              "provider_request",
              "provider_response",
              "qa",
              "export"
            ],
            "properties": {
              "brief": {
                "type": "string",
                "pattern": "^safety_decision_[a-z0-9_]+_brief$"
              },
              "provider_request": {
                "type": "string",
                "pattern": "^safety_decision_[a-z0-9_]+_provider_request$"
              },
              "provider_response": {
                "type": "string",
                "pattern": "^safety_decision_[a-z0-9_]+_provider_response$"
              },
              "qa": {
                "type": "string",
                "pattern": "^safety_decision_[a-z0-9_]+_qa$"
              },
              "export": {
                "type": "string",
                "pattern": "^safety_decision_[a-z0-9_]+_export$"
              }
            }
          },
          "must_block_final_export": {
            "type": "boolean"
          }
        }
      }
    },
    "release_gate_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_evidence_only",
        "blueprint_runtime_item_remains_open",
        "runtime_enforcement_validated"
      ],
      "properties": {
