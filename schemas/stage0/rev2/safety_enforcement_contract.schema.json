{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenart.local/schemas/stage0/rev2/safety_enforcement_contract.schema.json",
  "title": "ZenArt Stage 0 Rev2 Safety Enforcement Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "blueprint_source",
    "required_enforcement_points",
    "decision_storage_contract",
    "runtime_contracts",
    "pipeline_sequence_contract",
    "runtime_replay_contract",
    "decision_matrix",
    "fixture_links",
    "release_gate_policy",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "stage0.rev2"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^safety_enforcement_contract_[a-z0-9_]+$"
    },
    "blueprint_source": {
      "const": "Docs/stage0_blueprint_rev2.md"
    },
    "required_enforcement_points": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "brief",
          "provider_request",
          "provider_response",
          "qa",
          "export"
        ]
      }
    },
    "decision_storage_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table",
        "required_columns",
        "tenant_scoped",
        "audit_rationale_required"
      ],
      "properties": {
        "table": {
          "const": "safety_decisions"
        },
        "required_columns": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "id",
              "tenant_id",
              "rule_id",
              "subject_type",
              "subject_id",
              "enforcement_point",
              "decision",
              "rationale",
              "created_at"
            ]
          }
        },
        "tenant_scoped": {
          "const": true
        },
        "audit_rationale_required": {
          "const": true
        }
      }
    },
    "runtime_contracts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enforcement_point",
          "subject_types",
          "required_decision_actions",
          "trace_status_required",
          "blocks_export_when_blocking",
          "openapi_operation",
          "backend_evidence"
        ],
        "properties": {
          "enforcement_point": {
            "enum": [
              "brief",
              "provider_request",
              "provider_response",
              "qa",
              "export"
            ]
          },
          "subject_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "brief",
                "provider_request",
                "provider_response",
                "qa_result",
                "asset",
                "package",
                "export"
              ]
            }
          },
          "required_decision_actions": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "allow",
                "warn",
                "require_user_confirmation",
                "require_admin_review",
                "block"
              ]
            }
          },
          "trace_status_required": {
            "const": true
          },
          "blocks_export_when_blocking": {
            "type": "boolean"
          },
          "openapi_operation": {
            "enum": [
              "createSafetyDecision"
            ]
          },
          "backend_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "pipeline_sequence_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordered_enforcement_points",
        "transition_gates",
        "fail_closed_cases",
        "bypass_prevention_cases"
      ],
      "properties": {
        "ordered_enforcement_points": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "enum": [
              "brief",
              "provider_request",
              "provider_response",
              "qa",
              "export"
            ]
          }
        },
        "transition_gates": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "enforcement_point",
              "must_run_before",
              "required_subject_fields",
              "blocked_or_held_effect",
              "downstream_artifacts_created_on_block",
              "trace_status_required"
            ],
            "properties": {
              "stage": {
                "enum": [
                  "brief_completion",
                  "provider_request_dispatch",
                  "provider_response_acceptance",
                  "qa_completion",
                  "export_creation",
                  "export_artifact_recording"
                ]
              },
              "enforcement_point": {
                "enum": [
                  "brief",
                  "provider_request",
                  "provider_response",
                  "qa",
                  "export"
                ]
              },
              "must_run_before": {
                "enum": [
                  "brief_confirmed",
                  "provider_call",
                  "candidate_asset_acceptance",
                  "package_export_allowed",
                  "export_task_created",
                  "downloadable_artifact_recorded"
                ]
              },
              "required_subject_fields": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "tenant_id",
                    "project_id",
                    "task_id",
                    "qa_subject_type",
                    "qa_subject_id",
                    "export_id"
                  ]
                }
              },
              "blocked_or_held_effect": {
                "enum": [
                  "deny_generation",
                  "deny_provider_call",
                  "deny_asset_acceptance",
                  "deny_qa_completion",
                  "deny_export_task",
                  "deny_downloadable_artifact"
                ]
              },
              "downstream_artifacts_created_on_block": {
                "const": false
              },
              "trace_status_required": {
                "const": true
              }
            }
          }
        },
        "fail_closed_cases": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "input_gap",
              "expected_error",
              "creates_downstream_artifacts",
              "decision_rows_required_before_error"
            ],
            "properties": {
              "case_id": {
                "type": "string",
                "pattern": "^safety_[a-z0-9_]+$"
              },
              "input_gap": {
                "enum": [
                  "missing_tenant_id",
                  "missing_all_subjects",
                  "blocked_export_rule",
                  "held_review_decision"
                ]
              },
              "expected_error": {
                "enum": [
                  "ErrValidation",
                  "ErrSafetyBlocked",
                  "ErrSafetyReviewHold"
                ]
              },
              "creates_downstream_artifacts": {
                "const": false
              },
              "decision_rows_required_before_error": {
                "type": "boolean"
              }
            }
          }
        },
        "bypass_prevention_cases": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "transition_stage",
              "attempted_bypass",
              "skipped_enforcement_point",
              "attempted_downstream_transition",
              "expected_error",
              "creates_downstream_artifacts",
              "trace_status_required",
              "backend_evidence"
            ],
            "properties": {
              "case_id": {
                "type": "string",
                "pattern": "^safety_bypass_[a-z0-9_]+_denied$"
              },
              "transition_stage": {
                "enum": [
                  "brief_completion",
                  "provider_request_dispatch",
                  "provider_response_acceptance",
                  "qa_completion",
                  "export_creation",
                  "export_artifact_recording"
                ]
              },
              "attempted_bypass": {
                "enum": [
                  "confirm_brief_without_policy_decision",
                  "call_provider_without_provider_request_policy_decision",
                  "accept_asset_without_provider_response_policy_decision",
                  "mark_qa_complete_without_qa_policy_decision",
                  "create_export_task_without_export_policy_decision",
                  "record_downloadable_artifact_without_export_policy_decision"
                ]
              },
              "skipped_enforcement_point": {
                "enum": [
                  "brief",
                  "provider_request",
                  "provider_response",
                  "qa",
                  "export"
                ]
              },
              "attempted_downstream_transition": {
                "enum": [
                  "brief_confirmed",
                  "provider_call",
                  "candidate_asset_acceptance",
                  "package_export_allowed",
                  "export_task_created",
                  "downloadable_artifact_recorded"
                ]
              },
              "expected_error": {
                "enum": [
                  "ErrValidation",
                  "ErrSafetyBlocked",
                  "ErrSafetyReviewHold"
                ]
              },
              "creates_downstream_artifacts": {
                "const": false
              },
              "trace_status_required": {
                "const": true
              },
              "backend_evidence": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "decision_matrix": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enforcement_point",
          "actions"
        ],
        "properties": {
          "enforcement_point": {
            "enum": [
              "brief",
              "provider_request",
              "provider_response",
              "qa",
              "export"
            ]
          },
          "actions": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "decision",
                "source_fixture_id",
                "source_rule_id",
                "export_gate",
                "requires_trace_safety_status",
                "requires_persisted_decision",
                "requires_audit",
                "user_visible_outcome"
              ],
              "properties": {
                "decision": {
                  "enum": [
                    "allow",
                    "warn",
                    "require_user_confirmation",
                    "require_admin_review",
                    "block"
                  ]
                },
                "source_fixture_id": {
                  "type": "string",
                  "pattern": "^fx_[a-z0-9_]+$"
                },
                "source_rule_id": {
                  "type": "string",
                  "minLength": 1
                },
                "export_gate": {
                  "enum": [
                    "allow_when_export_contract_complete",
                    "allow_with_warning",
                    "hold_until_user_confirmation",
                    "hold_until_admin_review",
                    "block_final_export"
                  ]
                },
                "requires_trace_safety_status": {
                  "const": true
                },
                "requires_persisted_decision": {
                  "const": true
                },
                "requires_audit": {
                  "type": "boolean"
                },
                "user_visible_outcome": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "runtime_replay_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "mode",
        "status",
        "transition_gate_cases_replayed",
        "decision_matrix_cases_replayed",
        "fail_closed_cases_replayed",
        "bypass_prevention_cases_replayed",
        "fixture_link_cases_replayed",
        "transition_points_replayed",
        "decision_priority_order_validated",
        "held_or_blocked_require_audit_for_all_actions",
        "blocked_or_held_creates_downstream_artifacts",
        "trace_status_required_for_all_transitions",
        "persisted_decision_required_for_all_actions"
      ],
      "properties": {
        "runner": {
          "const": "scripts/run_safety_policy_runtime_contract.py"
        },
        "mode": {
          "const": "deterministic_fixture_replay"
        },
        "status": {
          "const": "pass"
        },
        "transition_gate_cases_replayed": {
          "type": "integer",
          "minimum": 6
        },
        "decision_matrix_cases_replayed": {
          "type": "integer",
          "minimum": 25
        },
        "fail_closed_cases_replayed": {
          "type": "integer",
          "minimum": 4
        },
        "bypass_prevention_cases_replayed": {
          "type": "integer",
          "minimum": 6
        },
        "fixture_link_cases_replayed": {
          "type": "integer",
          "minimum": 4
        },
        "transition_points_replayed": {
          "const": true
        },
        "decision_priority_order_validated": {
          "const": true
        },
        "held_or_blocked_require_audit_for_all_actions": {
          "const": true
        },
        "blocked_or_held_creates_downstream_artifacts": {
          "const": false
        },
        "trace_status_required_for_all_transitions": {
          "const": true
        },
        "persisted_decision_required_for_all_actions": {
          "const": true
        }
      }
    },
    "fixture_links": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "expected_safety_action",
          "expected_decision_source",
          "expected_source_rule_ids",
          "required_enforcement_points",
          "must_block_final_export"
        ],
        "properties": {
          "fixture_id": {
            "type": "string",
            "pattern": "^fx_[a-z0-9_]+$"
          },
          "expected_safety_action": {
            "enum": [
              "block",
              "require_user_confirmation",
              "require_admin_review",
              "warn"
            ]
          },
          "expected_decision_source": {
            "const": "linked_safety_rule"
          },
          "expected_source_rule_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^safety_[a-z0-9_]+$"
            }
          },
          "required_enforcement_points": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "enum": [
                "brief",
                "provider_request",
                "provider_response",
                "qa",
                "export"
              ]
            }
          },
          "must_block_final_export": {
            "type": "boolean"
          }
        }
      }
    },
    "release_gate_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_evidence_only",
        "blueprint_runtime_item_remains_open",
        "runtime_enforcement_validated"
      ],
      "properties": {
        "contract_evidence_only": {
          "type": "boolean"
        },
        "blueprint_runtime_item_remains_open": {
          "type": "boolean"
        },
        "runtime_enforcement_validated": {
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blueprint_sections",
        "created_by_lane"
      ],
      "properties": {
        "blueprint_sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^((15|23|24|25)\\.)"
          }
        },
        "created_by_lane": {
          "const": "lane2"
        }
      }
    }
  }
}
