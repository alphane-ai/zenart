          "type": "boolean"
        },
        "blueprint_runtime_item_remains_open": {
          "type": "boolean"
        },
        "runtime_enforcement_validated": {
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blueprint_sections",
        "created_by_lane"
      ],
      "properties": {
        "blueprint_sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^((15|23|24|25)\\.)"
          }
        },
        "created_by_lane": {
          "const": "lane2"
        }
      }
    }
  },
  "$defs": {
    "safety_action": {
      "enum": [
        "allow",
