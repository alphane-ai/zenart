{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenart.local/schemas/stage0/rev2/eval_suite.schema.json",
  "title": "ZenArt Stage 0 Rev2 Eval Suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "blueprint_source",
    "covers",
    "fixtures",
    "pass_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "stage0.rev2"
    },
    "suite_id": {
      "type": "string",
      "pattern": "^eval_[a-z0-9_]+$"
    },
    "blueprint_source": {
      "type": "string",
      "const": "Docs/stage0_blueprint_rev2.md"
    },
    "covers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "skills",
          "prompt_fragments",
          "prompt_mutations",
          "meta_prompts",
          "image_specs",
          "vertical_workflow_packs"
        ]
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "category",
          "workflow",
          "brief",
          "expected_dimensions",
          "expected_evidence",
          "provenance"
        ],
        "properties": {
          "fixture_id": {
            "type": "string",
            "pattern": "^fx_[a-z0-9_]+$"
          },
          "category": {
            "enum": [
              "golden",
              "ambiguous_brief",
              "unsafe",
              "negative",
              "brand_product_preservation",
              "text_heavy",
              "export_completeness",
              "regression",
              "red_team"
            ]
          },
          "workflow": {
            "type": "string",
            "minLength": 1
          },
          "brief": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "user_text",
              "inputs",
              "attachments"
            ],
            "properties": {
              "user_text": {
                "type": "string",
                "minLength": 1
              },
              "inputs": {
                "type": "object"
              },
              "attachments": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "expected_dimensions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "intent_routing_accuracy",
                "brief_completeness",
                "spec_schema_validity",
                "prompt_composition_compatibility",
                "safety_tag_recall",
                "four_option_distinctness",
                "image_qa",
                "text_readability",
                "product_logo_preservation",
                "package_export_completeness"
              ]
            }
          },
          "expected_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "minimum_candidates",
              "must_include_manifest",
              "must_include_qa_report",
              "must_include_trace_provenance",
              "expected_safety_action"
            ],
            "properties": {
              "minimum_candidates": {
                "type": "integer",
                "minimum": 0
              },
              "must_include_manifest": {
                "type": "boolean"
              },
              "must_include_qa_report": {
                "type": "boolean"
              },
              "must_include_trace_provenance": {
                "type": "boolean"
              },
              "expected_safety_action": {
                "enum": [
                  "allow",
                  "warn",
                  "require_user_confirmation",
                  "require_admin_review",
                  "block"
                ]
              }
            }
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          }
        }
      }
    },
    "pass_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_all_golden_pass",
        "requires_no_critical_safety_regression",
        "minimum_regression_pass_rate"
      ],
      "properties": {
        "requires_all_golden_pass": {
          "type": "boolean",
          "const": true
        },
        "requires_no_critical_safety_regression": {
          "type": "boolean",
          "const": true
        },
        "minimum_regression_pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blueprint_sections",
        "created_by_lane",
        "fixture_owner"
      ],
      "properties": {
        "blueprint_sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(14|15|23|24|25)\\."
          }
        },
        "created_by_lane": {
          "const": "lane6"
        },
        "fixture_owner": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
