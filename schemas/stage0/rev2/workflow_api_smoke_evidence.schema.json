{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenart.local/schemas/stage0/rev2/workflow_api_smoke_evidence.schema.json",
  "title": "ZenArt Stage 0 Rev2 Workflow API Smoke Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "blueprint_source",
    "created_by_lane",
    "created_at",
    "blueprint_sections",
    "runner",
    "mode",
    "status",
    "api_base_url",
    "checklist_policy",
    "workflow_results",
    "summary",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "stage0.rev2"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^workflow_api_smoke_[a-z0-9_]+$"
    },
    "blueprint_source": {
      "const": "Docs/stage0_blueprint_rev2.md"
    },
    "created_by_lane": {
      "const": "lane2"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "blueprint_sections": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^((6|14|15|24|25)\\.)"
      }
    },
    "runner": {
      "const": "scripts/run_workflow_api_smoke.py"
    },
    "mode": {
      "enum": [
        "dry_run",
        "live"
      ]
    },
    "status": {
      "enum": [
        "planned",
        "passed",
        "failed",
        "blocked"
      ]
    },
    "api_base_url": {
      "type": "string",
      "minLength": 1
    },
    "checklist_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_smoke_checklist_remains_open",
        "local_alpha_gate_remains_open",
        "runtime_evidence_required_for_closure",
        "blocked_blueprint_items"
      ],
      "properties": {
        "api_smoke_checklist_remains_open": {
          "type": "boolean"
        },
        "local_alpha_gate_remains_open": {
          "type": "boolean"
        },
        "runtime_evidence_required_for_closure": {
          "type": "boolean"
        },
        "blocked_blueprint_items": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "workflow_results": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/workflow_result"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_count",
        "planned_workflows",
        "passed_workflows",
        "failed_workflows",
        "blocked_workflows",
        "operation_count",
        "required_runtime_assertions_covered",
        "openapi_contract_validated",
        "fixture_contract_validated"
      ],
      "properties": {
        "workflow_count": {
          "type": "integer",
          "minimum": 4
        },
        "planned_workflows": {
          "type": "integer",
          "minimum": 0
        },
        "passed_workflows": {
          "type": "integer",
          "minimum": 0
        },
        "failed_workflows": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_workflows": {
          "type": "integer",
          "minimum": 0
        },
        "operation_count": {
          "type": "integer",
          "minimum": 32
        },
        "required_runtime_assertions_covered": {
          "type": "boolean"
        },
        "openapi_contract_validated": {
          "type": "boolean"
        },
        "fixture_contract_validated": {
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blueprint_sections",
        "created_by_lane",
        "source_fixtures",
        "validator"
      ],
      "properties": {
        "blueprint_sections": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^((6|14|15|24|25)\\.)"
          }
        },
        "created_by_lane": {
          "const": "lane2"
        },
        "source_fixtures": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validator": {
          "const": "scripts/validate_workflow_api_smoke_evidence.py"
        }
      }
    }
  },
  "$defs": {
    "workflow_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "status",
        "checklist_item",
        "operation_ids",
        "request_results",
        "expected_runtime_assertions",
        "contract_assertions"
      ],
      "properties": {
        "workflow_id": {
          "enum": [
            "ecommerce_growth_pack",
            "business_visual_doc_pack",
            "local_merchant_campaign_pack",
            "character_ip_concept_pack"
          ]
        },
        "status": {
          "enum": [
            "planned",
            "passed",
            "failed",
            "blocked"
          ]
        },
        "checklist_item": {
          "type": "string",
          "minLength": 1
        },
        "operation_ids": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "request_results": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/request_result"
          }
        },
        "expected_runtime_assertions": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contract_assertions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_inputs_checked",
            "taxonomy_checked",
            "required_assets_checked",
            "export_manifest_checked",
            "qa_report_checked",
            "trace_provenance_checked"
          ],
          "properties": {
            "required_inputs_checked": {
              "type": "boolean"
            },
            "taxonomy_checked": {
              "type": "boolean"
            },
            "required_assets_checked": {
              "type": "boolean"
            },
            "export_manifest_checked": {
              "type": "boolean"
            },
            "qa_report_checked": {
              "type": "boolean"
            },
            "trace_provenance_checked": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "request_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "operation_id",
        "method",
        "path_template",
        "resolved_path",
        "request_schema",
        "response_schema",
        "expected_status",
        "actual_status",
        "result",
        "requires_idempotency_key",
        "body_assertions",
        "runtime_assertions"
      ],
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 1
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "enum": [
            "get",
            "post",
            "put",
            "patch",
            "delete"
          ]
        },
        "path_template": {
          "type": "string",
          "pattern": "^/"
        },
        "resolved_path": {
          "type": "string",
          "pattern": "^/"
        },
        "request_schema": {
          "type": "string",
          "minLength": 1
        },
        "response_schema": {
          "type": "string",
          "minLength": 1
        },
        "expected_status": {
          "type": "string",
          "pattern": "^[0-9]{3}$"
        },
        "actual_status": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "planned",
            "passed",
            "failed",
            "blocked"
          ]
        },
        "requires_idempotency_key": {
          "type": "boolean"
        },
        "body_assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runtime_assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runtime_assertion"
          }
        }
      }
    },
    "runtime_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_id",
        "expected",
        "observed",
        "passed"
      ],
      "properties": {
        "assertion_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "expected": true,
        "observed": true,
        "passed": {
          "type": "boolean"
        }
      }
    }
  }
}
