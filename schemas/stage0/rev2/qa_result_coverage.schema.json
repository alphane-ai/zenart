{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenart.local/schemas/stage0/rev2/qa_result_coverage.schema.json",
  "title": "ZenArt Stage 0 Rev2 QA Result Coverage Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "blueprint_source",
    "qa_fixture",
    "required_categories",
    "required_outcomes",
    "category_contracts",
    "workflow_required_coverage",
    "vertical_acceptance_links",
    "outcome_examples",
    "category_outcome_examples",
    "eval_result_link",
    "export_gate_policy",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "stage0.rev2"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^qa_result_coverage_[a-z0-9_]+$"
    },
    "blueprint_source": {
      "const": "Docs/stage0_blueprint_rev2.md"
    },
    "qa_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "minimum_fixture_count",
        "check_id_unique",
        "trace_link_required",
        "eval_fixture_link_required"
      ],
      "properties": {
        "path": {
          "const": "fixtures/stage0/rev2/eval/qa_results.json"
        },
        "minimum_fixture_count": {
          "type": "integer",
          "minimum": 13
        },
        "check_id_unique": {
          "const": true
        },
        "trace_link_required": {
          "const": true
        },
        "eval_fixture_link_required": {
          "const": true
        }
      }
    },
    "required_categories": {
      "type": "array",
      "minItems": 13,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/qa_category"
      }
    },
    "required_outcomes": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "pass",
          "warn",
          "block"
        ]
      }
    },
    "category_contracts": {
      "type": "array",
      "minItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_category",
          "expected_outcomes",
          "required_observed_fields",
          "required_expected_fields",
          "blocks_final_export_when_blocking",
          "override_requires_audit",
          "trace_link_required",
          "source_artifacts_required"
        ],
        "properties": {
          "check_category": {
            "$ref": "#/$defs/qa_category"
          },
          "expected_outcomes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "pass",
                "warn",
                "block"
              ]
            }
          },
          "required_observed_fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_expected_fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "blocks_final_export_when_blocking": {
            "const": true
          },
          "override_requires_audit": {
            "const": true
          },
          "trace_link_required": {
            "const": true
          },
          "source_artifacts_required": {
            "const": true
          }
        }
      }
    },
    "workflow_required_coverage": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workflow_id",
          "required_qa_checks",
          "covered_qa_checks",
          "source_fixture_ids",
          "coverage_complete"
        ],
        "properties": {
          "workflow_id": {
            "enum": [
              "ecommerce_growth_pack",
              "business_visual_doc_pack",
              "local_merchant_campaign_pack",
              "character_ip_concept_pack"
            ]
          },
          "required_qa_checks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/qa_category"
            }
          },
          "covered_qa_checks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/qa_category"
            }
          },
          "source_fixture_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^fx_[a-z0-9_]+$"
            }
          },
          "coverage_complete": {
            "const": true
          }
        }
      }
    },
    "vertical_acceptance_links": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workflow_id",
          "acceptance_fixture",
          "golden_fixture_id",
          "eval_fixture_ids",
          "required_qa_checks",
          "qa_check_ids",
          "export_required_files",
          "required_manifest_files",
          "required_asset_files",
          "coverage_complete"
        ],
        "properties": {
          "workflow_id": {
            "enum": [
              "ecommerce_growth_pack",
              "business_visual_doc_pack",
              "local_merchant_campaign_pack",
              "character_ip_concept_pack"
            ]
          },
          "acceptance_fixture": {
            "type": "string",
            "pattern": "^fixtures/stage0/rev2/workflows/.+\\.json$"
          },
          "golden_fixture_id": {
            "type": "string",
            "pattern": "^fx_[a-z0-9_]+$"
          },
          "eval_fixture_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^fx_[a-z0-9_]+$"
            }
          },
          "required_qa_checks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/qa_category"
            }
          },
          "qa_check_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^qa_[a-z0-9_]+$"
            }
          },
          "export_required_files": {
            "type": "array",
            "minItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_manifest_files": {
            "type": "array",
            "minItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": [
                "manifest.json",
                "metadata.json",
                "qa_report.json",
                "trace_provenance.json"
              ]
            }
          },
          "required_asset_files": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^assets/.+"
            }
          },
          "coverage_complete": {
            "const": true
          }
        }
      }
    },
    "outcome_examples": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "outcome",
          "source",
          "fixture_id",
          "workflow",
          "trace_id",
          "check_ids",
          "final_export_allowed"
        ],
        "properties": {
          "outcome": {
            "enum": [
              "pass",
              "warn",
              "block"
            ]
          },
          "source": {
            "enum": [
              "eval_result_fixture",
              "qa_result_fixture"
            ]
          },
          "fixture_id": {
            "type": "string",
            "pattern": "^fx_[a-z0-9_]+$"
          },
          "workflow": {
            "type": "string",
            "minLength": 1
          },
          "trace_id": {
            "type": "string",
            "pattern": "^trace_[a-z0-9_]+$"
          },
          "check_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^qa_[a-z0-9_]+$"
            }
          },
          "final_export_allowed": {
            "type": "boolean"
          }
        }
      }
    },
    "category_outcome_examples": {
      "type": "array",
      "minItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_category",
          "outcome",
          "source",
          "fixture_id",
          "workflow",
          "trace_id",
          "check_ids",
          "final_export_allowed",
          "expected_blocks_final_export",
          "expected_export_artifacts_complete"
        ],
        "properties": {
          "check_category": {
            "$ref": "#/$defs/qa_category"
          },
          "outcome": {
            "enum": [
              "pass",
              "warn",
              "block"
            ]
          },
          "source": {
            "const": "qa_result_fixture"
          },
          "fixture_id": {
            "type": "string",
            "pattern": "^fx_[a-z0-9_]+$"
          },
          "workflow": {
            "enum": [
              "ecommerce_growth_pack",
              "business_visual_doc_pack",
              "local_merchant_campaign_pack",
              "character_ip_concept_pack"
            ]
          },
          "trace_id": {
            "type": "string",
            "pattern": "^trace_[a-z0-9_]+$"
          },
          "check_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^qa_[a-z0-9_]+$"
            }
          },
          "final_export_allowed": {
            "type": "boolean"
          },
          "expected_blocks_final_export": {
            "type": "boolean"
          },
          "expected_export_artifacts_complete": {
            "type": "boolean"
          }
        }
      }
    },
    "eval_result_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "requires_qa_categories_covered_match",
        "requires_qa_export_gate_match",
        "requires_trace_contract_match"
      ],
      "properties": {
        "path": {
          "const": "fixtures/stage0/rev2/eval/starter_eval_results.json"
        },
        "requires_qa_categories_covered_match": {
          "const": true
        },
        "requires_qa_export_gate_match": {
          "const": true
        },
        "requires_trace_contract_match": {
          "const": true
        }
      }
    },
    "export_gate_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocking_severity_blocks_final_export",
        "warning_severity_does_not_block_final_export",
        "pass_outcome_allows_final_export_when_export_contract_complete",
        "admin_override_requires_audit"
      ],
      "properties": {
        "blocking_severity_blocks_final_export": {
          "const": true
        },
        "warning_severity_does_not_block_final_export": {
          "const": true
        },
        "pass_outcome_allows_final_export_when_export_contract_complete": {
          "const": true
        },
        "admin_override_requires_audit": {
          "const": true
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blueprint_sections",
        "created_by_lane"
      ],
      "properties": {
        "blueprint_sections": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "created_by_lane": {
          "const": "lane2"
        }
      }
    }
  },
  "$defs": {
    "qa_category": {
      "enum": [
        "file_integrity",
        "dimensions",
        "aspect_ratio",
        "safe_area",
        "blank_output",
        "duplicate_similarity",
        "four_option_distinctness",
        "text_readability",
        "structured_text",
        "product_logo_preservation",
        "forbidden_claims",
        "watermark_signature_risk",
        "export_completeness"
      ]
    }
  }
}
