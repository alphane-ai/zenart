{
  "schema_version": "stage0.rev2",
  "workflow_id": "business_visual_doc_pack",
  "display_name": "Business Visual Document Pack",
  "required_inputs": [
    {
      "key": "document_goal",
      "label": "Document goal",
      "type": "text",
      "required": true
    },
    {
      "key": "source_notes",
      "label": "Source notes",
      "type": "file",
      "required": true
    },
    {
      "key": "audience",
      "label": "Audience",
      "type": "text",
      "required": true
    },
    {
      "key": "format",
      "label": "Format",
      "type": "enum",
      "required": true
    }
  ],
  "clarification_questions": [
    "Should the document optimize for executive summary or operational detail?",
    "Which brand palette and logo constraints apply?"
  ],
  "four_option_taxonomy": [
    "executive_brief",
    "strategy_memo",
    "sales_leave_behind",
    "board_update"
  ],
  "required_package_outputs": [
    "cover.png",
    "summary_page.png",
    "data_page.png",
    "recommendation_page.png",
    "manifest.json",
    "qa_report.json",
    "trace_provenance.json"
  ],
  "required_generated_assets": [
    {
      "asset_id": "cover",
      "file_name": "cover.png",
      "asset_kind": "document_page",
      "strategy_taxonomy": "executive_brief",
      "export_target": "memo_cover"
    },
    {
      "asset_id": "summary_page",
      "file_name": "summary_page.png",
      "asset_kind": "document_page",
      "strategy_taxonomy": "strategy_memo",
      "export_target": "memo_summary"
    },
    {
      "asset_id": "data_page",
      "file_name": "data_page.png",
      "asset_kind": "document_page",
      "strategy_taxonomy": "board_update",
      "export_target": "memo_data"
    },
    {
      "asset_id": "recommendation_page",
      "file_name": "recommendation_page.png",
      "asset_kind": "document_page",
      "strategy_taxonomy": "sales_leave_behind",
      "export_target": "memo_recommendations"
    }
  ],
  "required_qa_checks": [
    "text_readability",
    "forbidden_claims"
  ],
  "required_safety_checks": {
    "enforcement_points": [
      "brief",
      "provider_request",
      "provider_response",
      "qa",
      "export"
    ],
    "linked_rule_domains": [
      "financial"
    ],
    "linked_eval_fixtures": [
      "fx_unsafe_financial_claim"
    ]
  },
  "export_targets": [
    {
      "target_id": "zip_delivery",
      "format": "zip",
      "required_files": [
        "manifest.json",
        "assets/cover.png",
        "assets/summary_page.png",
        "assets/data_page.png",
        "assets/recommendation_page.png",
        "metadata.json",
        "qa_report.json",
        "trace_provenance.json"
      ]
    },
    {
      "target_id": "pdf_preview",
      "format": "pdf",
      "required_files": [
        "manifest.json",
        "assets/cover.png",
        "assets/summary_page.png",
        "assets/data_page.png",
        "assets/recommendation_page.png",
        "metadata.json",
        "qa_report.json",
        "trace_provenance.json"
      ]
    }
  ],
  "negative_fixture_links": [
    {
      "fixture_id": "fx_unsafe_financial_claim",
      "category": "unsafe",
      "expected_status": "blocked"
    }
  ],
  "api_smoke_contract": {
    "execution_status": "not_executed",
    "blueprint_checklist_remains_open": true,
    "operation_ids": [
      "createChatSession",
      "createChatMessage",
      "createCandidateSet",
      "listCandidateAssets",
      "selectDirection",
      "createPackage",
      "createExport",
      "getExport"
    ],
    "request_sequence": [
      {
        "step": 1,
        "operation_id": "createChatSession",
        "method": "post",
        "path_template": "/projects/{project_id}/chat/sessions",
        "requires_idempotency_key": true,
        "request_schema": "ChatSessionCreate",
        "success_status": "201",
        "response_schema": "ChatSession",
        "path_params": [
          "project_id"
        ],
        "body_assertions": [
          "title includes Business Visual Document Pack"
        ]
      },
      {
        "step": 2,
        "operation_id": "createChatMessage",
        "method": "post",
        "path_template": "/chat/sessions/{chat_session_id}/messages",
        "requires_idempotency_key": true,
        "request_schema": "ChatMessageCreate",
        "success_status": "202",
        "response_schema": "TaskStatus",
        "path_params": [
          "chat_session_id"
        ],
        "body_assertions": [
          "body contains document_goal",
          "body contains audience",
          "body contains format",
          "references includes source_notes upload"
        ]
      },
      {
        "step": 3,
        "operation_id": "createCandidateSet",
        "method": "post",
        "path_template": "/projects/{project_id}/candidate-sets",
        "requires_idempotency_key": true,
        "request_schema": "CandidateSetCreate",
        "success_status": "202",
        "response_schema": "TaskStatus",
        "path_params": [
          "project_id"
        ],
        "body_assertions": [
          "workflow_id equals business_visual_doc_pack",
          "brief contains document_goal, source_notes, audience, format"
        ]
      },
      {
        "step": 4,
        "operation_id": "listCandidateAssets",
        "method": "get",
        "path_template": "/candidate-sets/{candidate_set_id}/assets",
        "requires_idempotency_key": false,
        "request_schema": "none",
        "success_status": "200",
        "response_schema": "CandidateAssetPage",
        "path_params": [
          "candidate_set_id"
        ],
        "body_assertions": [
          "response contains four candidate assets",
          "assets cover executive_brief, strategy_memo, sales_leave_behind, board_update"
        ]
      },
      {
        "step": 5,
        "operation_id": "selectDirection",
        "method": "put",
        "path_template": "/projects/{project_id}/selected-direction",
        "requires_idempotency_key": true,
        "request_schema": "SelectedDirectionCreate",
        "success_status": "200",
        "response_schema": "SelectedDirection",
        "path_params": [
          "project_id"
        ],
        "body_assertions": [
          "candidate_asset_id references selected document candidate"
        ]
      },
      {
        "step": 6,
        "operation_id": "createPackage",
        "method": "post",
        "path_template": "/projects/{project_id}/packages",
        "requires_idempotency_key": true,
        "request_schema": "PackageCreate",
        "success_status": "201",
        "response_schema": "Package",
        "path_params": [
          "project_id"
        ],
        "body_assertions": [
          "items include cover.png, summary_page.png, data_page.png, recommendation_page.png"
        ]
      },
      {
        "step": 7,
        "operation_id": "createExport",
        "method": "post",
        "path_template": "/packages/{package_id}/exports",
        "requires_idempotency_key": true,
        "request_schema": "ExportCreate",
        "success_status": "202",
        "response_schema": "TaskStatus",
        "path_params": [
          "package_id"
        ],
        "body_assertions": [
          "format equals zip or pdf"
        ]
      },
      {
        "step": 8,
        "operation_id": "getExport",
        "method": "get",
        "path_template": "/exports/{export_id}",
        "requires_idempotency_key": false,
        "request_schema": "none",
        "success_status": "200",
        "response_schema": "Export",
        "path_params": [
          "export_id"
        ],
        "body_assertions": [
          "manifest, metadata, qa_report, trace_provenance, and required document pages are present",
          "qa_report contains text readability evidence"
        ]
      }
    ],
    "expected_runtime_assertions": [
      "brief with source_notes, audience, and format produces four document candidates",
      "text-heavy pages expose readability QA evidence",
      "unsupported financial claims trigger safety block or warning as configured",
      "export includes manifest, metadata, QA report, and trace provenance"
    ]
  },
  "playwright_happy_path_contract": {
    "execution_status": "not_executed",
    "blueprint_checklist_remains_open": true,
    "expected_user_steps": [
      "create project",
      "enter business document brief",
      "upload source notes",
      "review four candidates",
      "select one direction",
      "iterate selected direction",
      "add pages to package",
      "preview and download export"
    ]
  },
  "pass_thresholds": {
    "qa": {
      "blocking_allowed": false,
      "max_warning_count": 3
    },
    "safety": {
      "required_enforcement_points": [
        "brief",
        "provider_request",
        "provider_response",
        "qa",
        "export"
      ],
      "critical_regression_allowed": false
    },
    "export": {
      "requires_manifest": true,
      "requires_assets": true,
      "requires_qa_report": true,
      "requires_metadata": true,
      "requires_safety_disclaimer_when_applicable": true,
      "requires_trace_provenance": true
    }
  },
  "golden_fixture": {
    "fixture_id": "fx_business_visual_doc_golden",
    "brief": "Turn the quarterly retention notes into a concise investor-ready visual memo with clear charts and no unsupported claims.",
    "expected_candidate_count": 4,
    "expected_export_files": [
      "manifest.json",
      "assets/cover.png",
      "assets/summary_page.png",
      "qa_report.json",
      "trace_provenance.json"
    ]
  },
  "provenance": {
    "blueprint_sections": [
      "25.12"
    ],
    "created_by_lane": "lane6"
  }
}
