      },
      {
        "step": 4,
        "action": "generate_candidates",
        "route": "/projects/{project_id}",
        "selector": "[data-testid=\"generate-candidates\"]",
        "assertions": [
          "candidate generation task is accepted"
        ]
      },
      {
        "step": 5,
        "action": "review_four_candidates",
        "route": "/projects/{project_id}",
        "selector": "[data-testid=\"candidate-grid\"]",
        "assertions": [
          "candidate grid contains exactly four cards",
          "cards cover cute, heroic, dark, ornate"
        ]
      },
      {
        "step": 6,
        "action": "select_candidate",
        "route": "/projects/{project_id}",
        "selector": "[data-testid=\"candidate-card-cute\"]",
        "assertions": [
          "selected direction references one character IP candidate"
        ]
      },
      {
        "step": 7,
        "action": "iterate_selection",
        "route": "/projects/{project_id}",
        "selector": "[data-testid=\"iterate-selected-direction\"]",
        "assertions": [
          "iteration keeps safety policy and trace provenance attached"
        ]
      },
      {
        "step": 8,
        "action": "add_to_package",
        "route": "/projects/{project_id}",
        "selector": "[data-testid=\"package-add-selected\"]",
        "assertions": [
          "package contains avatar.png, half_body.png, costume_prop_variants.png, expression_sheet.png, promo_key_art.png, character_bible.json"
        ]
      },
      {
        "step": 9,
        "action": "preview_export",
        "route": "/projects/{project_id}/exports/{export_id}",
        "selector": "[data-testid=\"export-preview\"]",
        "assertions": [
          "export preview shows manifest, metadata, qa_report, trace_provenance, and applicable safety disclaimer"
        ]
      },
      {
        "step": 10,
        "action": "download_export",
        "route": "/projects/{project_id}/exports/{export_id}",
        "selector": "[data-testid=\"export-download\"]",
        "assertions": [
          "downloaded ZIP contains all required character concept assets"
        ]
      }
    ],
    "network_assertions": [
      {
        "operation_id": "createChatSession",
        "method": "post",
        "path_template": "/projects/{project_id}/chat/sessions",
        "success_status": "201"
      },
      {
        "operation_id": "createChatMessage",
        "method": "post",
        "path_template": "/chat/sessions/{chat_session_id}/messages",
        "success_status": "202"
      },
      {
        "operation_id": "createCandidateSet",
        "method": "post",
        "path_template": "/projects/{project_id}/candidate-sets",
        "success_status": "202"
      },
      {
        "operation_id": "listCandidateAssets",
        "method": "get",
        "path_template": "/candidate-sets/{candidate_set_id}/assets",
        "success_status": "200"
      },
      {
        "operation_id": "selectDirection",
        "method": "put",
        "path_template": "/projects/{project_id}/selected-direction",
        "success_status": "200"
      },
      {
        "operation_id": "createPackage",
        "method": "post",
        "path_template": "/projects/{project_id}/packages",
        "success_status": "201"
      },
      {
        "operation_id": "createExport",
        "method": "post",
        "path_template": "/packages/{package_id}/exports",
        "success_status": "202"
      },
      {
        "operation_id": "getExport",
        "method": "get",
        "path_template": "/exports/{export_id}",
        "success_status": "200"
      }
    ],
    "artifact_assertions": [
      "export includes assets/avatar.png",
      "export includes assets/half_body.png",
      "export includes assets/costume_prop_variants.png",
      "export includes assets/expression_sheet.png",
      "export includes assets/promo_key_art.png",
      "export includes assets/character_bible.json",
      "export includes manifest.json, metadata.json, qa_report.json, trace_provenance.json"
    ]
  },
  "pass_thresholds": {
    "qa": {
      "blocking_allowed": false,
      "max_warning_count": 2
    },
    "safety": {
      "required_enforcement_points": [
        "brief",
        "provider_request",
        "provider_response",
        "qa",
        "export"
      ],
      "critical_regression_allowed": false
