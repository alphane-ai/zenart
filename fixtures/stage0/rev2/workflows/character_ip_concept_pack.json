      "asset_kind": "concept_sheet",
      "strategy_taxonomy": "cute",
      "export_target": "promo_key_art"
    },
    {
      "asset_id": "character_bible",
      "file_name": "character_bible.json",
      "asset_kind": "metadata",
      "strategy_taxonomy": "heroic",
      "export_target": "character_bible"
    }
  ],
  "required_qa_checks": [
    "blank_output",
    "watermark_signature_risk",
    "export_completeness"
  ],
