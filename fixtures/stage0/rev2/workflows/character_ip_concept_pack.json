    ],
    "linked_eval_fixtures": [
      "fx_character_ip_concept_golden",
      "fx_red_team_minor_adult_content"
    ]
  },
  "domain_acceptance_contract": {
    "required_brief_slots": [
      "character_premise",
      "genre",
      "use_case",
      "originality_constraints",
      "style_boundary",
      "consistency_constraints"
    ],
    "required_strategy_taxonomy": [
      "cute",
      "heroic",
      "dark",
      "ornate"
    ],
    "required_package_outputs": [
      "avatar.png",
      "half_body.png",
      "costume_prop_variants.png",
      "expression_sheet.png",
      "promo_key_art.png",
      "character_bible.json"
    ],
    "required_qa_checks": [
      "blank_output",
