{
  "schema_version": "stage0.rev2",
  "workflow_id": "character_ip_concept_pack",
  "display_name": "Character IP Concept Pack",
  "required_inputs": [
    {
      "key": "character_brief",
      "label": "Character brief",
      "type": "text",
      "required": true
    },
    {
      "key": "target_audience",
      "label": "Target audience",
      "type": "text",
      "required": true
    },
    {
      "key": "style_constraints",
      "label": "Style constraints",
      "type": "text",
      "required": true
    },
    {
      "key": "reference_images",
      "label": "Reference images",
      "type": "file",
      "required": false
    }
  ],
  "clarification_questions": [
    "Is the character original, licensed, or inspired by existing IP?",
    "Which traits must remain stable across all four options?"
  ],
  "four_option_taxonomy": [
    "mascot_ready",
    "narrative_hero",
    "merchandise_icon",
    "animation_turnaround"
  ],
  "required_package_outputs": [
    "concept_sheet.png",
    "pose_grid.png",
    "expression_sheet.png",
    "style_tile.png",
    "manifest.json",
    "qa_report.json",
    "trace_provenance.json"
  ],
  "required_generated_assets": [
    {
      "asset_id": "concept_sheet",
      "file_name": "concept_sheet.png",
      "asset_kind": "concept_sheet",
      "strategy_taxonomy": "mascot_ready",
      "export_target": "character_concept"
    },
    {
      "asset_id": "pose_grid",
      "file_name": "pose_grid.png",
      "asset_kind": "concept_sheet",
      "strategy_taxonomy": "animation_turnaround",
      "export_target": "pose_reference"
    },
    {
      "asset_id": "expression_sheet",
      "file_name": "expression_sheet.png",
      "asset_kind": "concept_sheet",
      "strategy_taxonomy": "narrative_hero",
      "export_target": "expression_reference"
    },
    {
      "asset_id": "style_tile",
      "file_name": "style_tile.png",
      "asset_kind": "concept_sheet",
      "strategy_taxonomy": "merchandise_icon",
      "export_target": "style_reference"
    }
  ],
  "required_qa_checks": [
    "blank_output",
    "watermark_signature_risk",
    "export_completeness"
  ],
  "required_safety_checks": {
    "enforcement_points": [
      "brief",
      "provider_request",
      "provider_response",
      "qa",
      "export"
    ],
    "linked_rule_domains": [
      "adult_minor",
      "ip_brand"
    ],
    "linked_eval_fixtures": [
      "fx_character_ip_concept_golden",
      "fx_red_team_minor_adult_content"
    ]
  },
  "export_targets": [
    {
      "target_id": "zip_delivery",
      "format": "zip",
      "required_files": [
        "manifest.json",
        "assets/concept_sheet.png",
        "assets/pose_grid.png",
        "assets/expression_sheet.png",
        "assets/style_tile.png",
        "metadata.json",
        "qa_report.json",
        "trace_provenance.json"
      ]
    }
  ],
  "negative_fixture_links": [
    {
      "fixture_id": "fx_export_completeness_missing_manifest",
      "category": "export_completeness",
      "expected_status": "blocked"
    },
    {
      "fixture_id": "fx_red_team_minor_adult_content",
      "category": "red_team",
      "expected_status": "blocked"
    }
  ],
  "contract_evidence": {
    "eval_result_id": "eval_result_stage0_rev2_starter_contract",
    "eval_suite_id": "eval_stage0_rev2_starter",
    "golden_fixture_id": "fx_character_ip_concept_golden",
    "golden_eval_status": "blocked",
    "trace_id": "trace_fx_character_ip_concept_golden_blank",
    "trace_contract_ref": "fixtures/stage0/rev2/eval/trace_completeness.json",
    "required_trace_fields": [
      "schema_validation",
      "provenance",
      "safety_status",
      "qa_eval_status",
      "quota_transaction_id",
      "admin_visibility",
      "user_failure_mapping"
    ],
    "required_pipeline_steps": [
      "brief",
      "provider_request",
      "provider_response",
      "qa",
      "export"
    ],
    "export_contract": {
      "manifest": true,
      "qa_report": true,
      "metadata": true,
      "trace_provenance": true,
      "safety_disclaimer_when_applicable": true,
      "blocks_when_incomplete": true
    },
    "qa_export_gate": {
      "final_export_allowed": false,
      "export_artifacts_complete": true,
      "admin_override_required_for_export": true,
      "override_requires_audit": true
    },
    "source_fixtures": [
      "fixtures/stage0/rev2/eval/starter_eval_results.json",
      "fixtures/stage0/rev2/eval/starter_eval_suite.json",
      "fixtures/stage0/rev2/eval/trace_completeness.json"
    ],
    "validator": "scripts/validate_workflow_acceptance_contract.py"
  },
  "api_smoke_contract": {
    "execution_status": "not_executed",
    "blueprint_checklist_remains_open": true,
    "operation_ids": [
      "createChatSession",
      "createChatMessage",
      "createCandidateSet",
      "listCandidateAssets",
      "selectDirection",
      "createPackage",
      "createExport",
      "getExport"
    ],
    "request_sequence": [
      {
        "step": 1,
        "operation_id": "createChatSession",
        "method": "post",
        "path_template": "/projects/{project_id}/chat/sessions",
        "requires_idempotency_key": true,
        "request_schema": "ChatSessionCreate",
        "success_status": "201",
        "response_schema": "ChatSession",
        "path_params": [
          "project_id"
        ],
        "body_assertions": [
          "title includes Character IP Concept Pack"
        ]
      },
      {
        "step": 2,
        "operation_id": "createChatMessage",
        "method": "post",
        "path_template": "/chat/sessions/{chat_session_id}/messages",
        "requires_idempotency_key": true,
        "request_schema": "ChatMessageCreate",
        "success_status": "202",
        "response_schema": "TaskStatus",
        "path_params": [
          "chat_session_id"
        ],
        "body_assertions": [
          "body contains character_brief",
          "body contains target_audience",
          "body contains style_constraints",
          "references includes reference_images when provided"
        ]
      },
      {
        "step": 3,
        "operation_id": "createCandidateSet",
        "method": "post",
        "path_template": "/projects/{project_id}/candidate-sets",
        "requires_idempotency_key": true,
        "request_schema": "CandidateSetCreate",
        "success_status": "202",
        "response_schema": "TaskStatus",
        "path_params": [
          "project_id"
        ],
        "body_assertions": [
          "workflow_id equals character_ip_concept_pack",
          "brief contains character_brief, target_audience, style_constraints"
        ]
      },
      {
        "step": 4,
        "operation_id": "listCandidateAssets",
        "method": "get",
        "path_template": "/candidate-sets/{candidate_set_id}/assets",
        "requires_idempotency_key": false,
        "request_schema": "none",
        "success_status": "200",
        "response_schema": "CandidateAssetPage",
        "path_params": [
          "candidate_set_id"
        ],
        "body_assertions": [
          "response contains four candidate assets",
          "assets cover mascot_ready, narrative_hero, merchandise_icon, animation_turnaround"
        ]
      },
      {
        "step": 5,
        "operation_id": "selectDirection",
        "method": "put",
        "path_template": "/projects/{project_id}/selected-direction",
        "requires_idempotency_key": true,
        "request_schema": "SelectedDirectionCreate",
        "success_status": "200",
        "response_schema": "SelectedDirection",
        "path_params": [
          "project_id"
        ],
        "body_assertions": [
          "candidate_asset_id references selected character concept candidate"
        ]
      },
      {
        "step": 6,
        "operation_id": "createPackage",
        "method": "post",
        "path_template": "/projects/{project_id}/packages",
        "requires_idempotency_key": true,
        "request_schema": "PackageCreate",
        "success_status": "201",
        "response_schema": "Package",
        "path_params": [
          "project_id"
        ],
        "body_assertions": [
          "items include concept_sheet.png, pose_grid.png, expression_sheet.png, style_tile.png"
        ]
      },
      {
        "step": 7,
        "operation_id": "createExport",
        "method": "post",
        "path_template": "/packages/{package_id}/exports",
        "requires_idempotency_key": true,
        "request_schema": "ExportCreate",
        "success_status": "202",
        "response_schema": "TaskStatus",
        "path_params": [
          "package_id"
        ],
        "body_assertions": [
          "format equals zip"
        ]
      },
      {
        "step": 8,
        "operation_id": "getExport",
        "method": "get",
        "path_template": "/exports/{export_id}",
        "requires_idempotency_key": false,
        "request_schema": "none",
        "success_status": "200",
        "response_schema": "Export",
        "path_params": [
          "export_id"
        ],
        "body_assertions": [
          "manifest, metadata, qa_report, trace_provenance, and required concept sheets are present",
          "qa_report contains blank output and watermark signature risk evidence"
        ]
      }
    ],
    "expected_runtime_assertions": [
      "brief requires original character constraints and target audience",
      "candidate assets cover four IP concept strategy options",
      "safety policy blocks minor sexualization and third-party character resemblance risks",
      "export includes concept sheets, metadata, QA report, safety disclaimer when applicable, and trace provenance"
    ]
  },
  "playwright_happy_path_contract": {
    "execution_status": "not_executed",
    "blueprint_checklist_remains_open": true,
    "start_route": "/projects/new?workflow=character_ip_concept_pack",
    "completion_route": "/projects/{project_id}/exports/{export_id}",
    "expected_user_steps": [
      "create project",
      "enter character IP brief",
      "confirm original IP constraints",
      "review four candidates",
      "select one direction",
      "iterate selected direction",
      "add concept sheets to package",
      "preview and download export"
    ],
    "required_selectors": [
      "[data-testid=\"project-create\"]",
      "[data-testid=\"workflow-character_ip_concept_pack\"]",
      "[data-testid=\"brief-character_brief\"]",
      "[data-testid=\"brief-target_audience\"]",
      "[data-testid=\"brief-style_constraints\"]",
      "[data-testid=\"reference-upload-reference_images\"]",
      "[data-testid=\"original-ip-confirm\"]",
      "[data-testid=\"generate-candidates\"]",
      "[data-testid=\"candidate-grid\"]",
      "[data-testid=\"candidate-card-mascot_ready\"]",
      "[data-testid=\"candidate-select\"]",
      "[data-testid=\"iterate-selected-direction\"]",
      "[data-testid=\"package-add-selected\"]",
      "[data-testid=\"export-preview\"]",
      "[data-testid=\"export-download\"]"
    ],
    "user_journey": [
      {
        "step": 1,
        "action": "create_project",
        "route": "/projects/new?workflow=character_ip_concept_pack",
        "selector": "[data-testid=\"project-create\"]",
        "assertions": [
          "project workspace route opens with workflow=character_ip_concept_pack"
        ]
      },
      {
        "step": 2,
        "action": "fill_brief",
        "route": "/projects/{project_id}",
        "selector": "[data-testid=\"brief-character_brief\"]",
        "assertions": [
          "character_brief is captured in brief",
          "target_audience and style_constraints are captured in brief"
        ]
      },
      {
        "step": 3,
        "action": "confirm_original_ip_constraints",
        "route": "/projects/{project_id}",
        "selector": "[data-testid=\"original-ip-confirm\"]",
        "assertions": [
          "original IP confirmation is required before generation",
          "third-party character resemblance safety policy is attached"
        ]
      },
      {
        "step": 4,
        "action": "generate_candidates",
        "route": "/projects/{project_id}",
        "selector": "[data-testid=\"generate-candidates\"]",
        "assertions": [
          "candidate generation task is accepted"
        ]
      },
      {
        "step": 5,
        "action": "review_four_candidates",
        "route": "/projects/{project_id}",
        "selector": "[data-testid=\"candidate-grid\"]",
        "assertions": [
          "candidate grid contains exactly four cards",
          "cards cover mascot_ready, narrative_hero, merchandise_icon, animation_turnaround"
        ]
      },
      {
        "step": 6,
        "action": "select_candidate",
        "route": "/projects/{project_id}",
        "selector": "[data-testid=\"candidate-card-mascot_ready\"]",
        "assertions": [
          "selected direction references one character IP candidate"
        ]
      },
      {
        "step": 7,
        "action": "iterate_selection",
        "route": "/projects/{project_id}",
        "selector": "[data-testid=\"iterate-selected-direction\"]",
        "assertions": [
          "iteration keeps safety policy and trace provenance attached"
        ]
      },
      {
        "step": 8,
        "action": "add_to_package",
        "route": "/projects/{project_id}",
        "selector": "[data-testid=\"package-add-selected\"]",
        "assertions": [
          "package contains concept_sheet.png, pose_grid.png, expression_sheet.png, style_tile.png"
        ]
      },
      {
        "step": 9,
        "action": "preview_export",
        "route": "/projects/{project_id}/exports/{export_id}",
        "selector": "[data-testid=\"export-preview\"]",
        "assertions": [
          "export preview shows manifest, metadata, qa_report, trace_provenance, and applicable safety disclaimer"
        ]
      },
      {
        "step": 10,
        "action": "download_export",
        "route": "/projects/{project_id}/exports/{export_id}",
        "selector": "[data-testid=\"export-download\"]",
        "assertions": [
          "downloaded ZIP contains all required character concept assets"
        ]
      }
    ],
    "network_assertions": [
      {
        "operation_id": "createChatSession",
        "method": "post",
        "path_template": "/projects/{project_id}/chat/sessions",
        "success_status": "201"
      },
      {
        "operation_id": "createChatMessage",
        "method": "post",
        "path_template": "/chat/sessions/{chat_session_id}/messages",
        "success_status": "202"
      },
      {
        "operation_id": "createCandidateSet",
        "method": "post",
        "path_template": "/projects/{project_id}/candidate-sets",
        "success_status": "202"
      },
      {
        "operation_id": "listCandidateAssets",
        "method": "get",
        "path_template": "/candidate-sets/{candidate_set_id}/assets",
        "success_status": "200"
      },
      {
        "operation_id": "selectDirection",
        "method": "put",
        "path_template": "/projects/{project_id}/selected-direction",
        "success_status": "200"
      },
      {
        "operation_id": "createPackage",
        "method": "post",
        "path_template": "/projects/{project_id}/packages",
        "success_status": "201"
      },
      {
        "operation_id": "createExport",
        "method": "post",
        "path_template": "/packages/{package_id}/exports",
        "success_status": "202"
      },
      {
        "operation_id": "getExport",
        "method": "get",
        "path_template": "/exports/{export_id}",
        "success_status": "200"
      }
    ],
    "artifact_assertions": [
      "export includes assets/concept_sheet.png",
      "export includes assets/pose_grid.png",
      "export includes assets/expression_sheet.png",
      "export includes assets/style_tile.png",
      "export includes manifest.json, metadata.json, qa_report.json, trace_provenance.json"
    ]
  },
  "pass_thresholds": {
    "qa": {
      "blocking_allowed": false,
      "max_warning_count": 2
    },
    "safety": {
      "required_enforcement_points": [
        "brief",
        "provider_request",
        "provider_response",
        "qa",
        "export"
      ],
      "critical_regression_allowed": false
    },
    "export": {
      "requires_manifest": true,
      "requires_assets": true,
      "requires_qa_report": true,
      "requires_metadata": true,
      "requires_safety_disclaimer_when_applicable": true,
      "requires_trace_provenance": true
    }
  },
  "golden_fixture": {
    "fixture_id": "fx_character_ip_concept_golden",
    "brief": "Develop an original educational mascot named Nova Spark with consistent colors, no third-party character resemblance, and export-ready concept sheets.",
    "expected_candidate_count": 4,
    "expected_export_files": [
      "manifest.json",
      "metadata.json",
      "assets/concept_sheet.png",
      "assets/pose_grid.png",
