  "api_smoke_contract": {
    "execution_status": "not_executed",
    "blueprint_checklist_remains_open": true,
    "operation_ids": [
      "createChatSession",
      "createChatMessage",
      "createCandidateSet",
      "listCandidateAssets",
      "selectDirection",
      "createPackage",
      "createExport",
      "getExport"
    ],
    "request_sequence": [
      {
        "step": 1,
        "operation_id": "createChatSession",
        "method": "post",
        "path_template": "/projects/{project_id}/chat/sessions",
        "requires_idempotency_key": true,
        "request_schema": "ChatSessionCreate",
        "success_status": "201",
        "response_schema": "ChatSession",
        "path_params": [
          "project_id"
        ],
        "body_assertions": [
          "title includes Character IP Concept Pack"
        ]
      },
      {
        "step": 2,
        "operation_id": "createChatMessage",
        "method": "post",
        "path_template": "/chat/sessions/{chat_session_id}/messages",
        "requires_idempotency_key": true,
        "request_schema": "ChatMessageCreate",
        "success_status": "202",
        "response_schema": "TaskStatus",
        "path_params": [
          "chat_session_id"
        ],
        "body_assertions": [
          "body contains character_premise",
          "body contains genre",
          "body contains use_case",
          "body contains originality_constraints",
          "body contains style_boundary",
          "body contains consistency_constraints",
          "references includes reference_images when provided"
        ]
      },
      {
        "step": 3,
        "operation_id": "createCandidateSet",
        "method": "post",
        "path_template": "/projects/{project_id}/candidate-sets",
        "requires_idempotency_key": true,
        "request_schema": "CandidateSetCreate",
        "success_status": "202",
        "response_schema": "TaskStatus",
        "path_params": [
          "project_id"
        ],
        "body_assertions": [
          "workflow_id equals character_ip_concept_pack",
          "brief contains character_premise, genre, use_case, originality_constraints, style_boundary, consistency_constraints"
        ]
      },
      {
        "step": 4,
        "operation_id": "listCandidateAssets",
        "method": "get",
        "path_template": "/candidate-sets/{candidate_set_id}/assets",
        "requires_idempotency_key": false,
        "request_schema": "none",
        "success_status": "200",
        "response_schema": "CandidateAssetPage",
        "path_params": [
          "candidate_set_id"
        ],
        "body_assertions": [
          "response contains four candidate assets",
          "assets cover cute, heroic, dark, ornate"
        ]
      },
      {
        "step": 5,
        "operation_id": "selectDirection",
        "method": "put",
        "path_template": "/projects/{project_id}/selected-direction",
        "requires_idempotency_key": true,
        "request_schema": "SelectedDirectionCreate",
        "success_status": "200",
        "response_schema": "SelectedDirection",
        "path_params": [
          "project_id"
        ],
        "body_assertions": [
          "candidate_asset_id references selected character concept candidate"
        ]
      },
      {
        "step": 6,
        "operation_id": "createPackage",
        "method": "post",
        "path_template": "/projects/{project_id}/packages",
        "requires_idempotency_key": true,
        "request_schema": "PackageCreate",
        "success_status": "201",
        "response_schema": "Package",
        "path_params": [
          "project_id"
        ],
        "body_assertions": [
          "items include avatar.png, half_body.png, costume_prop_variants.png, expression_sheet.png, promo_key_art.png, character_bible.json"
        ]
      },
      {
        "step": 7,
        "operation_id": "createExport",
        "method": "post",
        "path_template": "/packages/{package_id}/exports",
        "requires_idempotency_key": true,
        "request_schema": "ExportCreate",
        "success_status": "202",
        "response_schema": "TaskStatus",
        "path_params": [
          "package_id"
        ],
        "body_assertions": [
          "format equals zip"
        ]
      },
      {
        "step": 8,
        "operation_id": "getExport",
        "method": "get",
        "path_template": "/exports/{export_id}",
        "requires_idempotency_key": false,
        "request_schema": "none",
        "success_status": "200",
        "response_schema": "Export",
        "path_params": [
          "export_id"
        ],
        "body_assertions": [
          "manifest, metadata, qa_report, trace_provenance, and required concept sheets are present",
          "qa_report contains blank output and watermark signature risk evidence"
        ]
      }
    ],
    "expected_runtime_assertions": [
      "brief requires character premise, genre, use case, originality constraints, style boundary, and consistency constraints",
      "candidate assets cover four character options: cute, heroic, dark, and ornate",
      "safety policy blocks minor sexualization and third-party character resemblance risks",
      "export includes avatar, half body, costume or prop variants, expression sheet, promo key art, character bible metadata, QA report, safety disclaimer when applicable, and trace provenance"
    ]
  },
  "playwright_happy_path_contract": {
    "execution_status": "not_executed",
    "blueprint_checklist_remains_open": true,
    "start_route": "/projects/new?workflow=character_ip_concept_pack",
