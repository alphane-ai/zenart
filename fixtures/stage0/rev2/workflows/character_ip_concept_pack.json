      "key": "character_premise",
      "label": "Character premise",
      "type": "text",
      "required": true
    },
    {
      "key": "genre",
      "label": "Genre",
      "type": "text",
      "required": true
    },
    {
      "key": "use_case",
      "label": "Use case",
      "type": "text",
      "required": true
    },
    {
      "key": "originality_constraints",
      "label": "Originality constraints",
      "type": "text",
      "required": true
