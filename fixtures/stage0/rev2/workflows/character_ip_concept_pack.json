        "assets/avatar.png",
        "assets/half_body.png",
        "assets/costume_prop_variants.png",
        "assets/expression_sheet.png",
        "assets/promo_key_art.png",
        "assets/character_bible.json",
        "metadata.json",
        "qa_report.json",
        "trace_provenance.json"
      ]
