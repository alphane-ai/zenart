{
  "schema_version": "stage0.rev2",
  "workflow_id": "local_merchant_campaign_pack",
  "display_name": "Local Merchant Campaign Pack",
  "required_inputs": [
    {
      "key": "merchant_name",
      "label": "Merchant name",
      "type": "text",
      "required": true
    },
    {
      "key": "event_date",
      "label": "Event date",
      "type": "date",
      "required": true
    },
    {
      "key": "address",
      "label": "Address",
      "type": "text",
      "required": true
    },
    {
      "key": "promotion",
      "label": "Promotion",
      "type": "text",
      "required": false
    }
  ],
  "clarification_questions": [
    "Which local audience should see the campaign first?",
    "Do price, date, phone, address, or QR details need exact preservation?"
  ],
  "four_option_taxonomy": [
    "grand_opening",
    "limited_time_offer",
    "community_event",
    "loyalty_push"
  ],
  "required_package_outputs": [
    "storefront_poster.png",
    "flyer.png",
    "social_square.png",
    "story_panel.png",
    "manifest.json",
    "qa_report.json",
    "trace_provenance.json"
  ],
  "required_generated_assets": [
    {
      "asset_id": "storefront_poster",
      "file_name": "storefront_poster.png",
      "asset_kind": "image",
      "strategy_taxonomy": "grand_opening",
      "export_target": "print_poster"
    },
    {
      "asset_id": "flyer",
      "file_name": "flyer.png",
      "asset_kind": "image",
      "strategy_taxonomy": "limited_time_offer",
      "export_target": "print_flyer"
    },
    {
      "asset_id": "social_square",
      "file_name": "social_square.png",
      "asset_kind": "image",
      "strategy_taxonomy": "community_event",
      "export_target": "social_square"
    },
    {
      "asset_id": "story_panel",
      "file_name": "story_panel.png",
      "asset_kind": "image",
      "strategy_taxonomy": "loyalty_push",
      "export_target": "social_story"
    }
  ],
  "required_qa_checks": [
    "dimensions",
    "safe_area",
    "structured_text"
  ],
  "required_safety_checks": {
    "enforcement_points": [
      "brief",
      "provider_request",
      "provider_response",
      "qa",
      "export"
    ],
    "linked_rule_domains": [
      "ip_brand"
    ],
    "linked_eval_fixtures": [
      "fx_brand_product_preservation"
    ]
  },
  "export_targets": [
    {
      "target_id": "zip_delivery",
      "format": "zip",
      "required_files": [
        "manifest.json",
        "assets/storefront_poster.png",
        "assets/flyer.png",
        "assets/social_square.png",
        "assets/story_panel.png",
        "metadata.json",
        "qa_report.json",
        "trace_provenance.json"
      ]
    }
  ],
  "negative_fixture_links": [
    {
      "fixture_id": "fx_negative_generic_rendering",
      "category": "negative",
      "expected_status": "blocked"
    },
    {
      "fixture_id": "fx_text_heavy_structured_details",
      "category": "text_heavy",
      "expected_status": "pass"
    }
  ],
  "api_smoke_contract": {
    "execution_status": "not_executed",
    "blueprint_checklist_remains_open": true,
    "operation_ids": [
      "createChatSession",
      "createChatMessage",
      "createCandidateSet",
      "listCandidateAssets",
      "selectDirection",
      "createPackage",
      "createExport",
      "getExport"
    ],
    "request_sequence": [
      {
        "step": 1,
        "operation_id": "createChatSession",
        "method": "post",
        "path_template": "/projects/{project_id}/chat/sessions",
        "requires_idempotency_key": true,
        "request_schema": "ChatSessionCreate",
        "success_status": "201",
        "response_schema": "ChatSession",
        "path_params": [
          "project_id"
        ],
        "body_assertions": [
          "title includes Local Merchant Campaign Pack"
        ]
      },
      {
        "step": 2,
        "operation_id": "createChatMessage",
        "method": "post",
        "path_template": "/chat/sessions/{chat_session_id}/messages",
        "requires_idempotency_key": true,
        "request_schema": "ChatMessageCreate",
        "success_status": "202",
        "response_schema": "TaskStatus",
        "path_params": [
          "chat_session_id"
        ],
        "body_assertions": [
          "body contains merchant_name",
          "body contains event_date",
          "body contains address",
          "body contains promotion when provided"
        ]
      },
      {
        "step": 3,
        "operation_id": "createCandidateSet",
        "method": "post",
        "path_template": "/projects/{project_id}/candidate-sets",
        "requires_idempotency_key": true,
        "request_schema": "CandidateSetCreate",
        "success_status": "202",
        "response_schema": "TaskStatus",
        "path_params": [
          "project_id"
        ],
        "body_assertions": [
          "workflow_id equals local_merchant_campaign_pack",
          "brief contains merchant_name, event_date, address, promotion"
        ]
      },
      {
        "step": 4,
        "operation_id": "listCandidateAssets",
        "method": "get",
        "path_template": "/candidate-sets/{candidate_set_id}/assets",
        "requires_idempotency_key": false,
        "request_schema": "none",
        "success_status": "200",
        "response_schema": "CandidateAssetPage",
        "path_params": [
          "candidate_set_id"
        ],
        "body_assertions": [
          "response contains four candidate assets",
          "assets cover grand_opening, limited_time_offer, community_event, loyalty_push"
        ]
      },
      {
        "step": 5,
        "operation_id": "selectDirection",
        "method": "put",
        "path_template": "/projects/{project_id}/selected-direction",
        "requires_idempotency_key": true,
        "request_schema": "SelectedDirectionCreate",
        "success_status": "200",
        "response_schema": "SelectedDirection",
        "path_params": [
          "project_id"
        ],
        "body_assertions": [
          "candidate_asset_id references selected merchant campaign candidate"
        ]
      },
      {
        "step": 6,
        "operation_id": "createPackage",
        "method": "post",
        "path_template": "/projects/{project_id}/packages",
        "requires_idempotency_key": true,
        "request_schema": "PackageCreate",
        "success_status": "201",
        "response_schema": "Package",
        "path_params": [
          "project_id"
        ],
        "body_assertions": [
          "items include storefront_poster.png, flyer.png, social_square.png, story_panel.png"
        ]
      },
      {
        "step": 7,
        "operation_id": "createExport",
        "method": "post",
        "path_template": "/packages/{package_id}/exports",
        "requires_idempotency_key": true,
        "request_schema": "ExportCreate",
        "success_status": "202",
        "response_schema": "TaskStatus",
        "path_params": [
          "package_id"
        ],
        "body_assertions": [
          "format equals zip"
        ]
      },
      {
        "step": 8,
        "operation_id": "getExport",
        "method": "get",
        "path_template": "/exports/{export_id}",
        "requires_idempotency_key": false,
        "request_schema": "none",
        "success_status": "200",
        "response_schema": "Export",
        "path_params": [
          "export_id"
        ],
        "body_assertions": [
          "manifest, metadata, qa_report, trace_provenance, and required campaign assets are present",
          "qa_report contains structured text evidence for date, address, phone, and QR placeholders"
        ]
      }
    ],
    "expected_runtime_assertions": [
      "brief preserves merchant name, event date, address, promotion, and QR placeholder",
      "candidate assets cover four local merchant strategy options",
      "structured text QA compares price, date, phone, address, and QR fields",
      "export blocks when required package evidence is incomplete"
    ]
  },
  "playwright_happy_path_contract": {
    "execution_status": "not_executed",
    "blueprint_checklist_remains_open": true,
    "expected_user_steps": [
      "create project",
      "enter local merchant brief",
      "confirm structured event details",
      "review four candidates",
      "select one direction",
      "iterate selected direction",
      "add campaign assets to package",
      "preview and download export"
    ]
  },
  "pass_thresholds": {
    "qa": {
      "blocking_allowed": false,
      "max_warning_count": 2
    },
    "safety": {
      "required_enforcement_points": [
        "brief",
        "provider_request",
        "provider_response",
        "qa",
        "export"
      ],
      "critical_regression_allowed": false
    },
    "export": {
      "requires_manifest": true,
      "requires_assets": true,
      "requires_qa_report": true,
      "requires_metadata": true,
      "requires_safety_disclaimer_when_applicable": true,
      "requires_trace_provenance": true
    }
  },
  "golden_fixture": {
    "fixture_id": "fx_local_merchant_campaign_golden",
    "brief": "Create a weekend tasting campaign for North Pier Coffee at 18 Dock Street with exact date, address, and QR placeholder preserved.",
    "expected_candidate_count": 4,
    "expected_export_files": [
      "manifest.json",
      "assets/storefront_poster.png",
      "assets/flyer.png",
      "qa_report.json",
      "trace_provenance.json"
    ]
  },
  "provenance": {
    "blueprint_sections": [
      "25.12"
    ],
    "created_by_lane": "lane6"
  }
}
