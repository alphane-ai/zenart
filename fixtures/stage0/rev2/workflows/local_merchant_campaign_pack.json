    {
      "key": "merchant_name",
      "label": "Merchant name",
      "type": "text",
      "required": true
    },
    {
      "key": "event_date",
      "label": "Event date",
      "type": "date",
      "required": true
    },
    {
      "key": "address",
      "label": "Address",
      "type": "text",
      "required": true
    },
    {
      "key": "promotion",
      "label": "Promotion",
      "type": "text",
      "required": false
    }
  ],
  "clarification_questions": [
    "Which local audience should see the campaign first?",
    "Do price, date, phone, address, or QR details need exact preservation?"
