{
  "schema_version": "stage0.rev2",
  "workflow_id": "ecommerce_growth_pack",
  "display_name": "Ecommerce Growth Pack",
  "required_inputs": [
    {
      "key": "product_name",
      "label": "Product name",
      "type": "text",
      "required": true
    },
    {
      "key": "product_image",
      "label": "Product image",
      "type": "file",
      "required": true
    },
    {
      "key": "target_channel",
      "label": "Target channel",
      "type": "enum",
      "required": true
    },
    {
      "key": "offer",
      "label": "Offer",
      "type": "text",
      "required": true
    }
  ],
  "clarification_questions": [
    "Which audience segment should the pack prioritize?",
    "Are there restricted claims or approved phrases for the product?"
  ],
  "four_option_taxonomy": [
    "conversion_offer",
    "social_proof",
    "feature_comparison",
    "retention_bundle"
  ],
  "required_package_outputs": [
    "hero_product_ad.png",
    "square_social_ad.png",
    "story_variant.png",
    "marketplace_banner.png",
    "manifest.json",
    "qa_report.json",
    "trace_provenance.json"
  ],
  "required_generated_assets": [
    {
      "asset_id": "hero_product_ad",
      "file_name": "hero_product_ad.png",
      "asset_kind": "image",
      "strategy_taxonomy": "conversion_offer",
      "export_target": "web_hero"
    },
    {
      "asset_id": "square_social_ad",
      "file_name": "square_social_ad.png",
      "asset_kind": "image",
      "strategy_taxonomy": "social_proof",
      "export_target": "social_square"
    },
    {
      "asset_id": "story_variant",
      "file_name": "story_variant.png",
      "asset_kind": "image",
      "strategy_taxonomy": "feature_comparison",
      "export_target": "social_story"
    },
    {
      "asset_id": "marketplace_banner",
      "file_name": "marketplace_banner.png",
      "asset_kind": "image",
      "strategy_taxonomy": "retention_bundle",
      "export_target": "marketplace_banner"
    }
  ],
  "required_qa_checks": [
    "file_integrity",
    "aspect_ratio",
    "duplicate_similarity",
    "four_option_distinctness",
    "product_logo_preservation"
  ],
  "required_safety_checks": {
    "enforcement_points": [
      "brief",
      "provider_request",
      "provider_response",
      "qa",
      "export"
    ],
    "linked_rule_domains": [
      "ip_brand"
    ],
    "linked_eval_fixtures": [
      "fx_brand_product_preservation"
    ]
  },
  "domain_acceptance_contract": {
    "required_brief_slots": [
      "product_name",
      "product_image",
      "target_channel",
      "offer"
    ],
    "required_strategy_taxonomy": [
      "conversion_offer",
      "social_proof",
      "feature_comparison",
      "retention_bundle"
    ],
    "required_package_outputs": [
      "hero_product_ad.png",
      "square_social_ad.png",
      "story_variant.png",
      "marketplace_banner.png"
    ],
    "required_qa_checks": [
      "file_integrity",
      "aspect_ratio",
      "duplicate_similarity",
      "four_option_distinctness",
      "product_logo_preservation"
    ],
    "required_safety_domains": [
      "ip_brand"
    ],
    "required_export_targets": [
      "web_hero",
      "social_square",
      "social_story",
      "marketplace_banner"
    ],
    "negative_acceptance_guards": [
      "missing_product_or_claim_constraints_blocks_generation",
      "brand_product_preservation_blocks_unauthorized_changes"
    ]
  },
  "export_targets": [
    {
      "target_id": "zip_delivery",
      "format": "zip",
      "required_files": [
        "manifest.json",
        "assets/hero_product_ad.png",
        "assets/square_social_ad.png",
        "assets/story_variant.png",
        "assets/marketplace_banner.png",
        "metadata.json",
        "qa_report.json",
        "trace_provenance.json"
      ]
    }
  ],
  "negative_fixture_links": [
    {
      "fixture_id": "fx_ambiguous_brief_missing_product",
      "category": "ambiguous_brief",
      "expected_status": "blocked"
    },
    {
      "fixture_id": "fx_brand_product_preservation",
      "category": "brand_product_preservation",
      "expected_status": "blocked"
    }
  ],
  "contract_evidence": {
    "eval_result_id": "eval_result_stage0_rev2_starter_contract",
    "eval_suite_id": "eval_stage0_rev2_starter",
    "golden_fixture_id": "fx_ecommerce_growth_golden",
    "golden_eval_status": "blocked",
    "trace_id": "trace_fx_ecommerce_growth_golden_aspect",
    "trace_contract_ref": "fixtures/stage0/rev2/eval/trace_completeness.json",
    "required_trace_fields": [
      "schema_validation",
      "provenance",
      "safety_status",
      "qa_eval_status",
      "quota_transaction_id",
      "admin_visibility",
      "user_failure_mapping"
    ],
    "required_pipeline_steps": [
      "brief",
      "provider_request",
      "provider_response",
      "qa",
      "export"
    ],
    "export_contract": {
      "manifest": true,
      "qa_report": true,
      "metadata": true,
      "trace_provenance": true,
      "safety_disclaimer_when_applicable": true,
      "blocks_when_incomplete": true
    },
    "qa_export_gate": {
      "final_export_allowed": false,
      "export_artifacts_complete": true,
      "admin_override_required_for_export": true,
      "override_requires_audit": true
    },
    "source_fixtures": [
      "fixtures/stage0/rev2/eval/starter_eval_results.json",
      "fixtures/stage0/rev2/eval/starter_eval_suite.json",
      "fixtures/stage0/rev2/eval/trace_completeness.json"
    ],
    "validator": "scripts/validate_workflow_acceptance_contract.py"
  },
  "api_smoke_contract": {
    "execution_status": "not_executed",
    "blueprint_checklist_remains_open": true,
    "operation_ids": [
      "createChatSession",
      "createChatMessage",
      "createCandidateSet",
      "listCandidateAssets",
      "selectDirection",
      "createPackage",
      "createExport",
      "getExport"
    ],
    "request_sequence": [
      {
        "step": 1,
        "operation_id": "createChatSession",
        "method": "post",
        "path_template": "/projects/{project_id}/chat/sessions",
        "requires_idempotency_key": true,
        "request_schema": "ChatSessionCreate",
        "success_status": "201",
        "response_schema": "ChatSession",
        "path_params": [
          "project_id"
        ],
        "body_assertions": [
          "title includes Ecommerce Growth Pack"
        ]
      },
      {
        "step": 2,
        "operation_id": "createChatMessage",
        "method": "post",
        "path_template": "/chat/sessions/{chat_session_id}/messages",
        "requires_idempotency_key": true,
        "request_schema": "ChatMessageCreate",
        "success_status": "202",
        "response_schema": "TaskStatus",
        "path_params": [
          "chat_session_id"
        ],
        "body_assertions": [
          "body contains product_name",
          "body contains target_channel",
          "references includes product_image upload"
        ]
      },
      {
        "step": 3,
        "operation_id": "createCandidateSet",
        "method": "post",
        "path_template": "/projects/{project_id}/candidate-sets",
        "requires_idempotency_key": true,
        "request_schema": "CandidateSetCreate",
        "success_status": "202",
        "response_schema": "TaskStatus",
        "path_params": [
          "project_id"
        ],
        "body_assertions": [
          "workflow_id equals ecommerce_growth_pack",
          "brief contains product_name, product_image, target_channel"
        ]
      },
      {
        "step": 4,
        "operation_id": "listCandidateAssets",
        "method": "get",
        "path_template": "/candidate-sets/{candidate_set_id}/assets",
        "requires_idempotency_key": false,
        "request_schema": "none",
        "success_status": "200",
        "response_schema": "CandidateAssetPage",
        "path_params": [
          "candidate_set_id"
        ],
        "body_assertions": [
          "response contains four candidate assets",
          "assets cover conversion_offer, social_proof, feature_comparison, retention_bundle"
        ]
      },
      {
        "step": 5,
        "operation_id": "selectDirection",
        "method": "put",
        "path_template": "/projects/{project_id}/selected-direction",
        "requires_idempotency_key": true,
        "request_schema": "SelectedDirectionCreate",
        "success_status": "200",
        "response_schema": "SelectedDirection",
        "path_params": [
          "project_id"
        ],
        "body_assertions": [
          "candidate_asset_id references selected ecommerce candidate"
        ]
      },
      {
        "step": 6,
        "operation_id": "createPackage",
        "method": "post",
        "path_template": "/projects/{project_id}/packages",
        "requires_idempotency_key": true,
        "request_schema": "PackageCreate",
        "success_status": "201",
        "response_schema": "Package",
        "path_params": [
          "project_id"
        ],
        "body_assertions": [
          "items include hero_product_ad.png, square_social_ad.png, story_variant.png, marketplace_banner.png"
        ]
      },
      {
        "step": 7,
        "operation_id": "createExport",
        "method": "post",
        "path_template": "/packages/{package_id}/exports",
        "requires_idempotency_key": true,
        "request_schema": "ExportCreate",
        "success_status": "202",
        "response_schema": "TaskStatus",
        "path_params": [
          "package_id"
        ],
        "body_assertions": [
          "format equals zip"
        ]
      },
      {
        "step": 8,
        "operation_id": "getExport",
        "method": "get",
        "path_template": "/exports/{export_id}",
        "requires_idempotency_key": false,
        "request_schema": "none",
        "success_status": "200",
        "response_schema": "Export",
        "path_params": [
          "export_id"
        ],
        "body_assertions": [
          "manifest, metadata, qa_report, trace_provenance, and required asset files are present",
          "download_url is short-lived when export is ready"
        ]
      }
    ],
    "expected_runtime_assertions": [
      "brief with product_name, product_image, target_channel produces four candidates",
      "candidate assets cover all four strategy taxonomy entries",
      "selected direction can be packaged with all required outputs",
      "export blocks when required manifest, QA report, metadata, or trace provenance is missing"
    ]
  },
  "playwright_happy_path_contract": {
    "execution_status": "not_executed",
    "blueprint_checklist_remains_open": true,
    "start_route": "/projects/new?workflow=ecommerce_growth_pack",
    "completion_route": "/projects/{project_id}/exports/{export_id}",
    "expected_user_steps": [
      "create project",
      "enter ecommerce brief",
      "upload product image",
      "review four candidates",
      "select one direction",
      "iterate selected direction",
      "add assets to package",
      "preview and download export"
    ],
    "required_selectors": [
      "[data-testid=\"project-create\"]",
      "[data-testid=\"workflow-ecommerce_growth_pack\"]",
      "[data-testid=\"brief-product_name\"]",
      "[data-testid=\"brief-target_channel\"]",
      "[data-testid=\"brief-offer\"]",
      "[data-testid=\"reference-upload-product_image\"]",
      "[data-testid=\"generate-candidates\"]",
      "[data-testid=\"candidate-grid\"]",
      "[data-testid=\"candidate-card-conversion_offer\"]",
      "[data-testid=\"candidate-select\"]",
      "[data-testid=\"iterate-selected-direction\"]",
      "[data-testid=\"package-add-selected\"]",
      "[data-testid=\"export-preview\"]",
      "[data-testid=\"export-download\"]"
    ],
    "user_journey": [
      {
        "step": 1,
        "action": "create_project",
        "route": "/projects/new?workflow=ecommerce_growth_pack",
        "selector": "[data-testid=\"project-create\"]",
        "assertions": [
          "project workspace route opens with workflow=ecommerce_growth_pack"
        ]
      },
      {
        "step": 2,
        "action": "fill_brief",
        "route": "/projects/{project_id}",
        "selector": "[data-testid=\"brief-product_name\"]",
        "assertions": [
          "product_name is captured in brief",
          "target_channel is captured in brief"
        ]
      },
      {
        "step": 3,
        "action": "upload_reference",
        "route": "/projects/{project_id}",
        "selector": "[data-testid=\"reference-upload-product_image\"]",
        "assertions": [
          "product_image upload returns tenant-scoped asset reference"
        ]
      },
      {
        "step": 4,
        "action": "generate_candidates",
        "route": "/projects/{project_id}",
        "selector": "[data-testid=\"generate-candidates\"]",
        "assertions": [
          "candidate generation task is accepted"
        ]
      },
      {
        "step": 5,
        "action": "review_four_candidates",
        "route": "/projects/{project_id}",
        "selector": "[data-testid=\"candidate-grid\"]",
        "assertions": [
          "candidate grid contains exactly four cards",
          "cards cover conversion_offer, social_proof, feature_comparison, retention_bundle"
        ]
      },
      {
        "step": 6,
        "action": "select_candidate",
        "route": "/projects/{project_id}",
        "selector": "[data-testid=\"candidate-card-conversion_offer\"]",
        "assertions": [
          "selected direction references one ecommerce candidate"
        ]
      },
      {
        "step": 7,
        "action": "iterate_selection",
        "route": "/projects/{project_id}",
        "selector": "[data-testid=\"iterate-selected-direction\"]",
        "assertions": [
          "iteration keeps workflow and trace provenance attached"
        ]
      },
      {
        "step": 8,
        "action": "add_to_package",
        "route": "/projects/{project_id}",
        "selector": "[data-testid=\"package-add-selected\"]",
        "assertions": [
          "package contains hero_product_ad.png, square_social_ad.png, story_variant.png, marketplace_banner.png"
        ]
      },
      {
        "step": 9,
        "action": "preview_export",
        "route": "/projects/{project_id}/exports/{export_id}",
        "selector": "[data-testid=\"export-preview\"]",
        "assertions": [
          "export preview shows manifest, metadata, qa_report, and trace_provenance"
        ]
      },
      {
        "step": 10,
        "action": "download_export",
        "route": "/projects/{project_id}/exports/{export_id}",
        "selector": "[data-testid=\"export-download\"]",
        "assertions": [
          "downloaded ZIP contains all required ecommerce assets"
        ]
      }
    ],
    "network_assertions": [
      {
        "operation_id": "createChatSession",
        "method": "post",
        "path_template": "/projects/{project_id}/chat/sessions",
        "success_status": "201"
      },
      {
        "operation_id": "createChatMessage",
        "method": "post",
        "path_template": "/chat/sessions/{chat_session_id}/messages",
        "success_status": "202"
      },
      {
        "operation_id": "createCandidateSet",
        "method": "post",
        "path_template": "/projects/{project_id}/candidate-sets",
        "success_status": "202"
      },
      {
        "operation_id": "listCandidateAssets",
        "method": "get",
        "path_template": "/candidate-sets/{candidate_set_id}/assets",
        "success_status": "200"
      },
      {
        "operation_id": "selectDirection",
        "method": "put",
        "path_template": "/projects/{project_id}/selected-direction",
        "success_status": "200"
      },
      {
        "operation_id": "createPackage",
        "method": "post",
        "path_template": "/projects/{project_id}/packages",
        "success_status": "201"
      },
      {
        "operation_id": "createExport",
        "method": "post",
        "path_template": "/packages/{package_id}/exports",
        "success_status": "202"
      },
      {
        "operation_id": "getExport",
        "method": "get",
        "path_template": "/exports/{export_id}",
        "success_status": "200"
      }
    ],
    "artifact_assertions": [
      "export includes assets/hero_product_ad.png",
      "export includes assets/square_social_ad.png",
      "export includes assets/story_variant.png",
      "export includes assets/marketplace_banner.png",
      "export includes manifest.json, metadata.json, qa_report.json, trace_provenance.json"
    ]
  },
  "pass_thresholds": {
    "qa": {
      "blocking_allowed": false,
      "max_warning_count": 2
    },
    "safety": {
      "required_enforcement_points": [
        "brief",
        "provider_request",
        "provider_response",
        "qa",
        "export"
      ],
      "critical_regression_allowed": false
    },
    "export": {
      "requires_manifest": true,
      "requires_assets": true,
      "requires_qa_report": true,
      "requires_metadata": true,
      "requires_safety_disclaimer_when_applicable": true,
      "requires_trace_provenance": true
    }
  },
  "golden_fixture": {
    "fixture_id": "fx_ecommerce_growth_golden",
    "brief": "Create a launch ad pack for the Aurora insulated bottle using the supplied packshot, targeting outdoor commuters on web and social.",
    "expected_candidate_count": 4,
    "expected_export_files": [
      "manifest.json",
      "metadata.json",
