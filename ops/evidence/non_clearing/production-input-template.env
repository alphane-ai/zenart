# Stage 1 production input template for zenari.ai
# Values are intentionally blank. Keep filled copies private and gitignored.
# This file is non-clearing evidence and cannot close production launch gates.

# Production DNS and HTTPS
# Required proof requirements: 4
# Required template variables: 6
# PRODUCTION_WEB_URL should be the public HTTPS production URL.
# Cloudflare values may be omitted only when DNS is applied manually and evidence is recorded elsewhere.
# PRODUCTION_WEB_URL or --production-web-url
PRODUCTION_WEB_URL=

# PRODUCTION_DNS_TARGET
PRODUCTION_DNS_TARGET=

# CLOUDFLARE_ZONE_ID or CF_ZONE_ID
# Accepted alternatives: CLOUDFLARE_ZONE_ID, CF_ZONE_ID
CLOUDFLARE_ZONE_ID=
CF_ZONE_ID=

# CLOUDFLARE_API_TOKEN or CF_API_TOKEN
# Accepted alternatives: CLOUDFLARE_API_TOKEN, CF_API_TOKEN
CLOUDFLARE_API_TOKEN=
CF_API_TOKEN=

# Production Stripe live billing lifecycle
# Required proof requirements: 20
# Required template variables: 22
# Use live mode only. Do not put sandbox IDs in this production template.
# Store raw Stripe keys only in a private local env file, never in committed evidence.
# STRIPE_MODE=live
STRIPE_MODE=

# STRIPE_SECRET_KEY or STRIPE_API_KEY with live key shape
# Accepted alternatives: STRIPE_SECRET_KEY, STRIPE_API_KEY
STRIPE_SECRET_KEY=
STRIPE_API_KEY=

# STRIPE_PUBLISHABLE_KEY or NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY with live key shape
# Accepted alternatives: STRIPE_PUBLISHABLE_KEY, NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

