# ZenArt Stage 0 Rev2 local/CI environment.
# Authoritative requirements: Docs/stage0_blueprint_rev2.md

# Runtime
ZENART_ENV=local
SERVICE_NAME=zenart-backend
PUBLIC_APP_ORIGIN=http://localhost:3000
PUBLIC_ADMIN_ORIGIN=http://localhost:3001
API_BASE_URL=http://localhost:8080

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_STAGE0_ACCESS_MODE=local
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Admin
ADMIN_PORT=3001
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_ADMIN_AUTH_MODE=local

# Backend HTTP
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
BACKEND_PORT=8080
TASK_SCHEMA_VERSION=1
WORKER_INSTANCE_ID=stage0-local-worker
WORKER_VERSION=stage0-local
WORKER_POLL_INTERVAL=2s
WORKER_CLAIM_TIMEOUT=15m
WORKER_DRAIN_GRACE_TIMEOUT=10s

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=zenart
POSTGRES_USER=zenart
POSTGRES_PASSWORD=zenart
DATABASE_URL=postgres://zenart:zenart@postgres:5432/zenart?sslmode=disable
POSTGRES_CHECK_TIMEOUT=2s

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CHECK_TIMEOUT=2s

# Object storage
OBJECT_STORAGE_PROVIDER=s3-compatible
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=zenart-local
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_LOCAL_ROOT=.local-objectstore
OBJECT_STORAGE_SIGNING_KEY=stage0-local-object-signing
OBJECT_STORAGE_CHECK_TIMEOUT=2s
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Auth/session
STAGE0_ACCESS_MODE=local
SESSION_COOKIE_NAME=zenart_session
SESSION_SECRET=replace-with-32-byte-local-secret
SESSION_TTL=24h
ADMIN_SESSION_COOKIE_NAME=zenart_admin_session
ADMIN_SESSION_SECRET=replace-with-32-byte-admin-local-secret
LOCAL_SEED_USER_EMAIL=local.user@example.com
LOCAL_SEED_ADMIN_EMAIL=local.admin@example.com

# Provider/dev generation
PROVIDER_MODE=dev
DEV_PROVIDER_SEED=zenart-stage0-rev2
PROVIDER_REQUEST_TIMEOUT=60s
PROVIDER_DAILY_SPEND_CAP_CENTS=0
PROVIDER_EMERGENCY_KILL_SWITCH=false

# Billing/quota
CHECKOUT_PROVIDER=mock
WEEKLY_QUOTA_UNITS=1000
BILLING_WEBHOOK_SECRET=replace-for-nonlocal

# Observability
LOG_FORMAT=json
LOG_LEVEL=info
REQUEST_ID_HEADER=X-Request-ID
OTEL_ENABLED=false
OTEL_SERVICE_NAME=zenart
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
METRICS_ENABLED=true
METRICS_PORT=9090
FRONTEND_ERROR_REPORTING_DSN=

# Crawler governance
CRAWLER_ENABLED=false
CRAWLER_USER_AGENT=ZenArtStage0Bot/0.1
CRAWLER_GLOBAL_RPS=0.2
CRAWLER_SOURCE_RPS=0.1
CRAWLER_RAW_RETENTION_DAYS=14

# Analytics
ANALYTICS_ENABLED=false
ANALYTICS_PROVIDER=disabled
ANALYTICS_WRITE_KEY=
