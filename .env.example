# ZenArt Stage 0 Rev2 local/CI environment.
# Authoritative requirements: Docs/stage0_blueprint_rev2.md

# Runtime
ZENART_ENV=local
SERVICE_NAME=zenart-backend
PUBLIC_APP_ORIGIN=http://localhost:3000
PUBLIC_ADMIN_ORIGIN=http://localhost:3001
API_BASE_URL=http://localhost:8080

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_STAGE0_ACCESS_MODE=local
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Admin
ADMIN_PORT=3001
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_ADMIN_AUTH_MODE=local

# Backend HTTP
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CONTENT_SECURITY_POLICY=default-src 'none'; frame-ancestors 'none'; base-uri 'none'
CSRF_HEADER_NAME=X-ZenArt-CSRF
CSRF_HEADER_VALUE=same-site-origin-check
MAX_UPLOAD_BYTES=26214400
ALLOWED_UPLOAD_CONTENT_TYPES=image/png,image/jpeg,image/webp,image/gif,application/pdf
UPLOAD_URL_TTL=10m
MALWARE_SCAN_PROVIDER=stage0-placeholder
MALWARE_SCAN_ENDPOINT=
MALWARE_SCAN_API_KEY=
MALWARE_SCAN_TIMEOUT=5s
MALWARE_SCAN_FAIL_CLOSED=false
TASK_SCHEMA_VERSION=1
WORKER_INSTANCE_ID=stage0-local-worker
WORKER_VERSION=stage0-local
WORKER_POLL_INTERVAL=2s
WORKER_CLAIM_TIMEOUT=15m
WORKER_DRAIN_GRACE_TIMEOUT=10s

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=zenart
POSTGRES_USER=zenart
POSTGRES_PASSWORD=zenart
DATABASE_URL=postgres://zenart:zenart@postgres:5432/zenart?sslmode=disable
POSTGRES_CHECK_TIMEOUT=2s

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CHECK_TIMEOUT=2s

# Object storage
OBJECT_STORAGE_PROVIDER=s3-compatible
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=zenart-local
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_LOCAL_ROOT=.local-objectstore
OBJECT_STORAGE_SIGNING_KEY=stage0-local-object-signing
OBJECT_STORAGE_CHECK_TIMEOUT=2s
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Auth/session
STAGE0_ACCESS_MODE=local
SESSION_COOKIE_NAME=__Host-zenart_session
SESSION_SECRET=stage0-local-session-secret-minimum-32-bytes
SESSION_TTL=24h
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_DOMAIN=
DEV_IDENTITY_HEADERS_ENABLED=true
ADMIN_SESSION_COOKIE_NAME=__Host-zenart_admin_session
ADMIN_SESSION_SECRET=stage0-local-admin-session-secret-minimum-32-bytes
ADMIN_SESSION_TTL=8h
LOCAL_SEED_USER_EMAIL=local.user@example.com
LOCAL_SEED_ADMIN_EMAIL=local.admin@example.com

# Provider/dev generation
PROVIDER_MODE=dev
DEV_PROVIDER_SEED=zenart-stage0-rev2
PROVIDER_REQUEST_TIMEOUT=60s
PROVIDER_DAILY_SPEND_CAP_CENTS=0
PROVIDER_EMERGENCY_KILL_SWITCH=false

# Billing/quota
CHECKOUT_PROVIDER=mock
WEEKLY_QUOTA_UNITS=1000
BILLING_WEBHOOK_SECRET=replace-for-nonlocal

# Observability
LOG_FORMAT=json
LOG_LEVEL=info
REQUEST_ID_HEADER=X-Request-ID
OTEL_ENABLED=false
OTEL_SERVICE_NAME=zenart
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
METRICS_ENABLED=true
METRICS_PORT=9090
WORKER_METRICS_PORT=9091
CRAWLER_METRICS_PORT=9092
FRONTEND_ERROR_REPORTING_DSN=

# Crawler governance
CRAWLER_ENABLED=false
CRAWLER_USER_AGENT=ZenArtStage0Bot/0.1
CRAWLER_GLOBAL_RPS=0.2
CRAWLER_SOURCE_RPS=0.1
CRAWLER_RAW_RETENTION_DAYS=14
CRAWLER_BLOCKLIST_HOSTS=localhost,127.0.0.1,169.254.169.254

# Analytics
ANALYTICS_ENABLED=false
ANALYTICS_PROVIDER=disabled
ANALYTICS_WRITE_KEY=
