# zenari.ai Stage 1 local/CI environment.
# Authoritative requirements: Docs/Stage1_20260621_blueprint.md

# Runtime
APP_BRAND_NAME=zenari.ai
APP_PUBLIC_DOMAIN=zenari.ai
NEXT_PUBLIC_APP_BRAND_NAME=zenari.ai
NEXT_PUBLIC_APP_DOMAIN=zenari.ai
ZENARI_ENV=local
SERVICE_NAME=zenari-backend
PUBLIC_APP_ORIGIN=http://localhost:26080
PUBLIC_ADMIN_ORIGIN=http://localhost:26081
API_BASE_URL=http://localhost:31080
NEXT_PUBLIC_ADMIN_BASE_PATH=

# Web
WEB_PORT=26080
NEXT_PUBLIC_API_BASE_URL=http://localhost:31080
NEXT_PUBLIC_STAGE0_ACCESS_MODE=local
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Admin
ADMIN_PORT=26081
ADMIN_PLAYWRIGHT_PORT=26181
ADMIN_API_BASE_URL=http://backend:8080
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:31080
NEXT_PUBLIC_ADMIN_AUTH_MODE=local

# Staging release probes
STAGING_SSH_HOST=
STAGING_SSH_USER=
STAGING_SSH_TARGET=
STAGING_SSH_KEY=
STAGING_SSH_PASSWORD=
STAGING_SSH_CONNECT_TIMEOUT=
STAGING_SSH_HARD_TIMEOUT=
STAGING_REMOTE_DIR=
STAGING_PUBLIC_HOST=
STAGING_ADMIN_HOST=
STAGING_PENDING_DOMAIN=
STAGING_INCLUDE_PRODUCTION_HOSTS=
STAGING_PRODUCTION_HOSTS=
STAGING_API_URL=
STAGING_WEB_URL=
STAGING_ADMIN_URL=
ADMIN_BEARER_TOKEN=
ADMIN_SESSION_COOKIE=
STAGING_ADMIN_SESSION_COOKIE=
SMOKE_ADMIN_USER_ID=
SMOKE_ADMIN_TENANT_ID=
CSRF_ORIGIN=
STAGING_DATABASE_URL=
# Optional override; defaults to STAGING_API_URL when empty.
STAGING_QUOTA_REPLAY_API_URL=
STAGING_QUOTA_REPLAY_TENANT_ID=
STAGING_QUOTA_REPLAY_BATCH_ID=

# Optional Azure CLI Run Command targeting.
# Leave blank unless this workstation has Azure CLI access to the staging VM.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=
AZURE_VM_NAME=

# Production DNS / public URL cutover probes
PRODUCTION_DNS_TARGET=
PRODUCTION_WEB_URL=
PRODUCTION_API_URL=
PRODUCTION_ADMIN_URL=
CLOUDFLARE_ZONE_ID=
CF_ZONE_ID=
CF_API_TOKEN=

# Backend HTTP
BACKEND_IMAGE=zenari-backend:local
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
BACKEND_PORT=31080
CORS_ALLOWED_ORIGINS=http://localhost:26080,http://localhost:26081
CONTENT_SECURITY_POLICY=default-src 'none'; frame-ancestors 'none'; base-uri 'none'
CSRF_HEADER_NAME=X-Zenari-CSRF
CSRF_HEADER_VALUE=same-site-origin-check
MAX_UPLOAD_BYTES=26214400
ALLOWED_UPLOAD_CONTENT_TYPES=image/png,image/jpeg,image/webp,image/gif,application/pdf
UPLOAD_URL_TTL=10m
MALWARE_SCAN_PROVIDER=stage0-placeholder
MALWARE_SCAN_ENDPOINT=
MALWARE_SCAN_API_KEY=
MALWARE_SCAN_TIMEOUT=5s
MALWARE_SCAN_FAIL_CLOSED=false
TASK_SCHEMA_VERSION=1
WORKER_INSTANCE_ID=stage0-local-worker
WORKER_VERSION=stage0-local
WORKER_POLL_INTERVAL=2s
WORKER_CLAIM_TIMEOUT=15m
WORKER_DRAIN_GRACE_TIMEOUT=10s
WORKER_CLEANUP_INTERVAL=1h

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=26432
POSTGRES_DB=zenari
POSTGRES_USER=zenari
POSTGRES_PASSWORD=zenari
DATABASE_URL=postgres://zenari:zenari@postgres:5432/zenari?sslmode=disable
POSTGRES_CHECK_TIMEOUT=2s

# Redis
REDIS_HOST=redis
REDIS_PORT=26379
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CHECK_TIMEOUT=2s

# Object storage
OBJECT_STORAGE_PROVIDER=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_PUBLIC_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_USE_SSL=
OBJECT_STORAGE_FORCE_PATH_STYLE=
OBJECT_STORAGE_LOCAL_ROOT=
OBJECT_STORAGE_SIGNING_KEY=
OBJECT_STORAGE_DOWNLOAD_URL_TTL=
OBJECT_STORAGE_CHECK_TIMEOUT=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_BUCKET_CREATE_JURISDICTION=
WORKER_CLEANUP_TIMEOUT=30s
WORKER_CLEANUP_BATCH_LIMIT=100
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=
MINIO_CONSOLE_PORT=

# Auth/session
STAGE0_ACCESS_MODE=local
SESSION_COOKIE_NAME=__Host-zenari_session
SESSION_SECRET=stage0-local-session-secret-minimum-32-bytes
SESSION_TTL=24h
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_DOMAIN=
DEV_IDENTITY_HEADERS_ENABLED=true
ADMIN_DEV_IDENTITY_HEADERS_ENABLED=false
ADMIN_SESSION_COOKIE_NAME=__Host-zenari_admin_session
ADMIN_SESSION_SECRET=stage0-local-admin-session-secret-minimum-32-bytes
ADMIN_SESSION_TTL=8h
LOCAL_SEED_USER_EMAIL=local.user@example.com
LOCAL_SEED_ADMIN_EMAIL=local.admin@example.com

# Provider/dev generation
PROVIDER_MODE=dev
DEV_PROVIDER_SEED=zenari-stage1-local
PROVIDER_REQUEST_TIMEOUT=60s
PROVIDER_DAILY_SPEND_CAP_CENTS=0
PROVIDER_EMERGENCY_KILL_SWITCH=false

# Rate limit / spend cap enforcement
RATELIMIT_ENABLED=true
RATELIMIT_STORE=memory
RATELIMIT_USER_REQUESTS_PER_MINUTE=60
RATELIMIT_TENANT_REQUESTS_PER_MINUTE=240
RATELIMIT_PROVIDER_REQUESTS_PER_MINUTE=120
RATELIMIT_ADMIN_ACTIONS_PER_MINUTE=30
RATELIMIT_PROVIDER_DAILY_SPEND_CAP_CENTS=0
RATELIMIT_PROVIDER_EMERGENCY_KILL_SWITCH=false

# LLM/OpenAI-compatible fallback
LLM_PROVIDER=openai-compatible
LLM_OPENAI_BASE_URL=
LLM_OPENAI_API_KEY=
# Optional aliases accepted for OpenAI-compatible providers:
ZAI_API_KEY=
OPENAI_API_KEY=
LLM_OPENAI_MODEL=glm-5.2
LLM_REQUEST_TIMEOUT=60s
LLM_ENABLE_LIVE_CALLS=false

# Billing/quota
CHECKOUT_PROVIDER=stripe
WEEKLY_QUOTA_UNITS=1000
STRIPE_MODE=test
STRIPE_API_BASE_URL=
STRIPE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_WEBHOOK_SECRET=
STRIPE_SANDBOX_PRODUCT_ID=
STRIPE_DEFAULT_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:26080/billing?stripe=success
STRIPE_CANCEL_URL=http://localhost:26080/billing?stripe=cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:26080/billing
STRIPE_CLI_FORWARD_TO=http://localhost:31080/api/v1/billing/webhook
STRIPE_SANDBOX_SELFTEST_REQUIRED=true

# Production proof bundle inputs: sanitized IDs/refs only; keep real .env gitignored.
STAGE1_PROD_BILLING_CHECKOUT_SESSION_ID=
STAGE1_PROD_BILLING_CHECKOUT_CUSTOMER_ID=
STAGE1_PROD_BILLING_PRICE_ID=
STAGE1_PROD_BILLING_ACTIVE_SUBSCRIPTION_ID=
