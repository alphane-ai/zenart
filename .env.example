# Observability
LOG_FORMAT=json
LOG_LEVEL=info
REQUEST_ID_HEADER=X-Request-ID
OTEL_ENABLED=false
OTEL_SERVICE_NAME=zenari-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
METRICS_ENABLED=true
METRICS_PORT=31990
WORKER_METRICS_PORT=31991
CRAWLER_METRICS_PORT=31992
WORKER_BATCH_ENABLED=false
WORKER_BATCH_TENANT_ID=tenant_1
WORKER_BATCH_POLL_INTERVAL=2s
WORKER_BATCH_CLAIM_LIMIT=4
WORKER_BATCH_CLAIM_TIMEOUT=15m
WORKER_BATCH_MAX_TENANT_CONCURRENCY=4
WORKER_BATCH_PROVIDER_MAX_CONCURRENCY=zenari-image-sandbox=4
WORKER_BATCH_PROVIDER_MODEL_MAX_CONCURRENCY=zenari-image-sandbox:glm-5.2=4
WORKER_BATCH_ALLOWED_PROVIDER_MODEL_TOOLS=zenari-image-sandbox:glm-5.2:image.generate
FRONTEND_ERROR_REPORTING_DSN=

# Crawler governance
CRAWLER_ENABLED=false
CRAWLER_USER_AGENT=ZenariStage1Bot/1.0
CRAWLER_GLOBAL_RPS=0.2
CRAWLER_SOURCE_RPS=0.1
CRAWLER_RAW_RETENTION_DAYS=14
CRAWLER_BLOCKLIST_HOSTS=localhost,127.0.0.1,169.254.169.254

# Analytics
ANALYTICS_ENABLED=false
ANALYTICS_PROVIDER=disabled
ANALYTICS_WRITE_KEY=
